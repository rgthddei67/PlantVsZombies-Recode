{
  "commands": [
    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 500 },
    { "op": "assert_state", "path": "advancedPauseEnabled", "equals": false },
    { "op": "assert_state", "path": "cards.0.selected", "equals": false },

    { "op": "click", "x": 220, "y": 25, "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "cards.0.selected", "equals": true },
    { "op": "move_mouse", "x": 350, "y": 180 },
    { "op": "wait_frames", "value": 2 },
    { "op": "key", "name": "space" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "paused", "equals": true },
    { "op": "assert_state", "path": "pauseGameplayInputBlocked", "equals": true },
    { "op": "assert_state", "path": "cards.0.selected", "equals": true },
    { "op": "move_mouse", "x": 442, "y": 128 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "plantPreviewCount", "equals": 1 },
    { "op": "screenshot", "name": "strict_pause_held_preview_follows_mouse" },
    { "op": "click", "x": 442, "y": 128, "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "plantCount", "equals": 0 },
    { "op": "assert_state", "path": "cards.0.selected", "equals": true },

    { "op": "key", "name": "space" },
    { "op": "wait_frames", "value": 2 },
    { "op": "click", "x": 800, "y": 500, "button": "right", "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "cards.0.selected", "equals": false },
    { "op": "key", "name": "space" },
    { "op": "wait_frames", "value": 3 },
    { "op": "click", "x": 220, "y": 25, "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "cards.0.selected", "equals": false },
    { "op": "assert_state", "path": "plantPreviewCount", "equals": 0 },
    { "op": "screenshot", "name": "strict_pause_card_slot_blocked" },

    { "op": "key", "name": "escape" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "paused", "equals": true },
    { "op": "assert_state", "path": "spacePauseActive", "equals": false },
    { "op": "assert_state", "path": "pauseMenuOpen", "equals": true },
    { "op": "assert_state", "path": "pauseGameplayInputBlocked", "equals": false },
    { "op": "assert_state", "path": "advancedPauseEnabled", "equals": false },
    { "op": "screenshot", "name": "escape_menu_without_advanced_pause_setting" },
    { "op": "key", "name": "escape" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "paused", "equals": false },

    { "op": "set_advanced_pause", "value": true },
    { "op": "assert_state", "path": "advancedPauseEnabled", "equals": true },

    { "op": "key", "name": "space" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "pauseGameplayInputBlocked", "equals": false },
    { "op": "click", "x": 220, "y": 25, "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "cards.0.selected", "equals": true },
    { "op": "click", "x": 442, "y": 128, "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "paused", "equals": true },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.type", "equals": "PLANT_PEASHOOTER" },
    { "op": "screenshot", "name": "advanced_pause_planted_while_paused" },
    { "op": "dump_state", "name": "advanced_pause_state" },
    { "op": "quit" }
  ]
}
