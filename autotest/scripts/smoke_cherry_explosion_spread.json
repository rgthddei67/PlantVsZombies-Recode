{
  "commands": [
    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": ["PLANT_CHERRYBOMB"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "add_ladder", "row": 0, "col": 4 },
    { "op": "add_ladder", "row": 1, "col": 4 },
    { "op": "add_ladder", "row": 3, "col": 6 },
    { "op": "add_ladder", "row": 2, "col": 7 },
    { "op": "assert_state", "path": "ladderCount", "equals": 4 },
    { "op": "plant", "type": "PLANT_CHERRYBOMB", "row": 2, "col": 5 },
    { "op": "wait_seconds", "value": 1.35, "timeout": 3 },
    { "op": "assert_state", "path": "ladderCount", "equals": 2 },
    { "op": "assert_state", "path": "ladders.0.row", "equals": 0 },
    { "op": "assert_state", "path": "ladders.0.col", "equals": 4 },
    { "op": "assert_state", "path": "ladders.1.row", "equals": 2 },
    { "op": "assert_state", "path": "ladders.1.col", "equals": 7 },
    { "op": "assert_state", "path": "particleEffectNameCounts.CherryBomb", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.CherryBomb.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "particleEffectsByName.CherryBomb.0.renderQuadCount", "atLeast": 20 },
    { "op": "assert_state", "path": "particleEffectsByName.CherryBomb.0.worldBounds.widthInt", "atLeast": 200 },
    { "op": "assert_state", "path": "particleEffectsByName.CherryBomb.0.worldBounds.heightInt", "atLeast": 200 },
    { "op": "screenshot", "name": "01_cherry_explosion_spread.png" },
    { "op": "dump_state", "name": "cherry_explosion_spread_state.json" },
    { "op": "wait_seconds", "value": 1.4, "timeout": 3 },
    { "op": "assert_state", "path": "particleEffectNameCounts.CherryBomb", "equals": 0 },
    { "op": "set_spawn_paused", "value": false },
    { "op": "quit" }
  ]
}
