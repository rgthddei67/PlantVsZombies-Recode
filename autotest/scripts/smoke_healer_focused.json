{
  "commands": [
    { "op": "goto_level", "level": 51, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_monte_carlo_ai", "value": false },

    { "op": "assert_state", "path": "healerResources.baseReanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.bodyLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.idleGearLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.areaGearLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.focusedGearLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.disabledGearLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.plusParticleLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.haloParticleLoaded", "equals": true },
    { "op": "assert_state", "path": "healerResources.soundsLoaded", "equals": true },

    { "op": "spawn_zombie", "type": "ZOMBIE_HEALER", "row": 2, "x": 650, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_BUCKET", "row": 2, "x": 800, "stationary": true },
    { "op": "assert_state", "path": "healerZombieCount", "equals": 1 },
    { "op": "assert_state", "path": "healerRowIndexVisibleCount", "equals": 1 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.bodyMaxHealth", "equals": 800 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.currentBiteDamage", "equals": 50 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerCooldownMs", "equals": 5000 },
    { "op": "damage_zombie", "type": "ZOMBIE_BUCKET", "damage": 600 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_BUCKET.helmHealth", "equals": 500 },
    { "op": "make_healer_ready" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerTreatmentState", "equals": "FOCUSED" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerFocusedTargetID", "equals": 2 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerGearTextureKey", "equals": "IMAGE_ZOMBIE_HEALER_GEAR_FOCUSED" },
    { "op": "assert_state", "path": "particleEffectNameCounts.HealerFocusedHeal", "equals": 0 },
    { "op": "save_level_snapshot", "name": "healer_focused_cast" },
    { "op": "reload_level_snapshot", "name": "healer_focused_cast" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerTreatmentState", "equals": "FOCUSED" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerFocusedTargetID", "equals": 2 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerCastRemainingMs", "atLeast": 850, "atMost": 1000 },
    { "op": "wait_seconds", "value": 0.45 },
    { "op": "screenshot", "name": "01_healer_focused_cast.png" },
    { "op": "wait_seconds", "value": 0.60 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_BUCKET.helmHealth", "equals": 900 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerTreatmentState", "equals": "IDLE" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerLastTargetCount", "equals": 1 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerLastTotalAmount", "equals": 400 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HEALER.healerCooldownMs", "atLeast": 4800, "atMost": 5000 },
    { "op": "assert_state", "path": "particleEffectNameCounts.HealerFocusedHeal", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.HealerFocusedHeal.0.activeParticleCount", "equals": 2 },
    { "op": "assert_state", "path": "particleEffectsByName.HealerFocusedHeal.0.nearestZombie.type", "equals": "ZOMBIE_BUCKET" },
    { "op": "assert_state", "path": "healerCastSoundRequestCount", "atLeast": 1 },
    { "op": "assert_state", "path": "healerFocusedSoundRequestCount", "atLeast": 1 },
    { "op": "screenshot", "name": "02_healer_focused_resolve.png" },
    { "op": "wait_seconds", "value": 1.0 },
    { "op": "assert_state", "path": "particleEffectNameCounts.HealerFocusedHeal", "equals": 0 },
    { "op": "dump_state", "name": "healer_focused_state.json" },
    { "op": "quit" }
  ]
}
