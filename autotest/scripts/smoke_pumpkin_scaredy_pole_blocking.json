{
  "commands": [
    { "op": "goto_level", "level": 10 },
    { "op": "choose_cards", "cards": ["PLANT_SCAREDYSHROOM", "PLANT_PUMPKINSHELL"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "set_timescale", "value": 5.0 },
    { "op": "plant", "type": "PLANT_SCAREDYSHROOM", "row": 2, "col": 1 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 3, "x": 380, "stationary": true },
    { "op": "wait_seconds", "value": 3.0, "timeout": 20 },
    { "op": "assert_state", "path": "scaredyShroomsByCell.2_1.fearState", "equals": "SCARED" },
    { "op": "plant", "type": "PLANT_PUMPKINSHELL", "row": 2, "col": 1 },
    { "op": "wait_seconds", "value": 7.0, "timeout": 40 },
    { "op": "assert_state", "path": "cells.2.1.normal", "equals": "PLANT_SCAREDYSHROOM" },
    { "op": "assert_state", "path": "cells.2.1.pumpkin", "equals": "PLANT_PUMPKINSHELL" },
    { "op": "assert_state", "path": "scaredyShroomsByCell.2_1.fearState", "equals": "READY" },
    { "op": "wait_seconds", "value": 4.0, "timeout": 25 },
    { "op": "assert_state", "path": "scaredyShroomsByCell.2_1.fearState", "equals": "READY" },
    { "op": "screenshot", "name": "01_scaredy_recovers_under_pumpkin.png" },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_TALLNUT", "PLANT_PUMPKINSHELL"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 5 },
    { "op": "plant", "type": "PLANT_PUMPKINSHELL", "row": 0, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_POLEVAULTER", "row": 0, "x": 760 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.vaultState", "equals": "JUMPING" },
    { "op": "assert_state", "path": "cells.0.5.normal", "equals": "PLANT_TALLNUT" },
    { "op": "assert_state", "path": "cells.0.5.pumpkin", "equals": "PLANT_PUMPKINSHELL" },
    { "op": "wait_seconds", "value": 1.1, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.vaultState", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.lastVaultDistanceOn1000", "equals": 0 },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "cells.0.5.normalHealth", "equals": 9000 },
    { "op": "assert_state", "path": "cells.0.5.pumpkinHealth", "equals": 4000 },
    { "op": "assert_state", "path": "topPlantsByCell.0_5.eaterCount", "equals": 1 },
    { "op": "screenshot", "name": "02_pumpkin_does_not_hide_tallnut_block.png" },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_WALLNUT", "PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 4 },
    { "op": "plant", "type": "PLANT_WALLNUT", "row": 0, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_POLEVAULTER", "row": 0, "x": 740 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.vaultState", "equals": "JUMPING" },
    { "op": "assert_state", "path": "topPlantsByCell.0_4.health", "equals": 9000 },
    { "op": "assert_state", "path": "topPlantsByCell.0_5.health", "equals": 4000 },
    { "op": "wait_seconds", "value": 1.1, "timeout": 5 },
    { "op": "assert_state", "path": "zombieCount", "equals": 2 },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_ELITE_POLEVAULTER" },
    { "op": "assert_state", "path": "zombies.0.vaultState", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.lastVaultDistanceOn1000", "equals": 0 },
    { "op": "assert_state", "path": "zombies.0.vaultExtraDistanceAppliedOn1000", "equals": 0 },
    { "op": "assert_state", "path": "topPlantsByCell.0_4.health", "equals": 8500 },
    { "op": "assert_state", "path": "topPlantsByCell.0_4.eaterCount", "equals": 1 },
    { "op": "assert_state", "path": "topPlantsByCell.0_5.health", "equals": 4000 },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "atLeast": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.TallNutBlock", "atLeast": 1 },
    { "op": "screenshot", "name": "03_elite_long_vault_stops_at_tallnut.png" },
    { "op": "dump_state", "name": "final_state.json" },
    { "op": "quit" }
  ]
}
