{
  "commands": [
    { "op": "set_all_owned_cards" },
    { "op": "goto_level", "level": 1 },
    { "op": "wait_seconds", "value": 5.0 },
    { "op": "assert_state", "path": "chooseCardReady", "equals": true },
    { "op": "assert_state", "path": "haveCardCount", "equals": 50 },
    { "op": "assert_state", "path": "chooseCardPageIndex", "equals": 0 },
    { "op": "assert_state", "path": "chooseCardPageNumber", "equals": 1 },
    { "op": "assert_state", "path": "chooseCardPageCount", "equals": 2 },
    { "op": "assert_state", "path": "chooseCardVisibleCardCount", "equals": 48 },
    { "op": "assert_state", "path": "chooseCardHiddenCardCount", "equals": 1 },
    { "op": "assert_state", "path": "chooseCardVisibleCards.0", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "chooseCardHiddenCards.0", "equals": "PLANT_GOLD_MAGNET" },
    { "op": "assert_state", "path": "chooseCardPageButton.enabled", "equals": true },
    { "op": "assert_state", "path": "chooseCardPageButton.visible", "equals": true },
    { "op": "assert_state", "path": "chooseCardPageButton.textureLoaded", "equals": true },
    { "op": "assert_state", "path": "chooseCardPageButton.rotationDegrees", "equals": 0 },
    { "op": "assert_state", "path": "chooseCardPageButton.centerXInt", "atLeast": 535, "atMost": 545 },
    { "op": "assert_state", "path": "chooseCardPageButton.centerYInt", "atLeast": 564, "atMost": 574 },
    { "op": "screenshot", "name": "choose_card_page_1.png" },

    { "op": "click", "target": "choose_card_page" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "chooseCardPageIndex", "equals": 1 },
    { "op": "assert_state", "path": "chooseCardPageNumber", "equals": 2 },
    { "op": "assert_state", "path": "chooseCardVisibleCardCount", "equals": 1 },
    { "op": "assert_state", "path": "chooseCardHiddenCardCount", "equals": 48 },
    { "op": "assert_state", "path": "chooseCardVisibleCards.0", "equals": "PLANT_GOLD_MAGNET" },
    { "op": "assert_state", "path": "chooseCardHiddenCards.0", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "chooseCardPageButton.rotationDegrees", "equals": 180 },
    { "op": "assert_state", "path": "chooseCardPageButton.centerXInt", "atLeast": 315, "atMost": 325 },
    { "op": "assert_state", "path": "chooseCardPageButton.centerYInt", "atLeast": 564, "atMost": 574 },
    { "op": "screenshot", "name": "choose_card_page_2.png" },

    { "op": "click", "target": "choose_card_page" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "chooseCardPageIndex", "equals": 0 },
    { "op": "assert_state", "path": "chooseCardVisibleCardCount", "equals": 48 },
    { "op": "assert_state", "path": "chooseCardHiddenCardCount", "equals": 1 },
    { "op": "assert_state", "path": "chooseCardHiddenCards.0", "equals": "PLANT_GOLD_MAGNET" },
    { "op": "assert_state", "path": "chooseCardPageButton.rotationDegrees", "equals": 0 },
    { "op": "screenshot", "name": "choose_card_page_1_returned.png" },
    { "op": "quit" }
  ]
}
