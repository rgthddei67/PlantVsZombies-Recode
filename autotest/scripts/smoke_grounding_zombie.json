    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.helmHealth", "equals": 430 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.nightRoofChargeGuideType", "equals": true },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.nightRoofChargeGuideEligible", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.guideCandidateCount", "equals": 1 },

    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 99 },
    { "op": "trigger_lightning" },
    { "op": "set_weather", "intensity": "CLEAR", "duration": 90 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "WARNING" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.row", "equals": 2 },
