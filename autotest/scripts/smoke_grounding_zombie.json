    { "op": "assert_state", "path": "weather.nightRoofCharge.routeRolloutCount", "equals": 32 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.routeCandidateCount", "equals": 6 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.routeSampledZombieCount", "equals": 1 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.routeSampledPlantCount", "equals": 2 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.routeDecisionMicros", "atLeast": 1 },
    { "op": "dump_state", "name": "grounding_route_probe.json" },
    { "op": "wait_seconds", "value": 0.4 },
    { "op": "screenshot", "name": "01_grounding_zombie_warning.png" },
    { "op": "save_level_snapshot", "name": "grounding_zombie_warning" },
    { "op": "reload_level_snapshot", "name": "grounding_zombie_warning" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.guided", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.row", "equals": 2 },
    { "op": "wait_seconds", "value": 3.7, "timeout": 7 },

    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "DISCHARGING" },
    { "op": "assert_state", "path": "topPlantsByCell.2_2.shutdown", "equals": true },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.shutdown", "equals": true },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.bodyHealth", "equals": 270 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.helmHealth", "equals": 430 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.buttered", "equals": false },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.paralyzed", "equals": false },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.slowed", "equals": true },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.controlImmunityMask", "equals": 14 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.frozenImmunityTimerMs", "atLeast": 9700, "atMost": 10000 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.butterImmunityTimerMs", "atLeast": 9700, "atMost": 10000 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.paralysisImmunityTimerMs", "atLeast": 9700, "atMost": 10000 },
    { "op": "assert_state", "path": "particleEffectNameCounts.GroundingZombieLightning", "atLeast": 1 },
    { "op": "screenshot", "name": "02_grounding_zombie_discharge.png" },

    { "op": "apply_zombie_control", "row": 2, "index": 0, "effect": "FROZEN", "expectedApplied": false },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.helmHealth", "equals": 410 },
    { "op": "apply_zombie_control", "row": 2, "index": 0, "effect": "BUTTER", "expectedApplied": false },
    { "op": "apply_zombie_control", "row": 2, "index": 0, "effect": "PARALYSIS", "duration": 4.0, "expectedApplied": false },
    { "op": "apply_zombie_control", "row": 2, "index": 0, "effect": "SLOW", "duration": 20.0, "expectedApplied": true },
    { "op": "damage_zombie", "type": "ZOMBIE_GROUNDING", "row": 2, "damage": 410, "source": "OTHER" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.helmHealth", "equals": 0 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.bodyHealth", "equals": 270 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.nightRoofChargeGuideEligible", "equals": false },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.controlImmunityMask", "equals": 14 },
    { "op": "apply_zombie_control", "row": 2, "index": 0, "effect": "BUTTER", "expectedApplied": false },
    { "op": "screenshot", "name": "03_grounding_zombie_hat_off.png" },
    { "op": "save_level_snapshot", "name": "grounding_zombie_immunity" },
    { "op": "reload_level_snapshot", "name": "grounding_zombie_immunity" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.helmHealth", "equals": 0 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.controlImmunityMask", "equals": 14 },
    { "op": "apply_zombie_control", "row": 2, "index": 0, "effect": "FROZEN", "expectedApplied": false },
    { "op": "wait_seconds", "value": 10.1, "timeout": 13 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GROUNDING.controlImmunityMask", "equals": 0 },
    { "op": "apply_zombie_control", "row": 2, "index": 0, "effect": "BUTTER", "expectedApplied": true },
    { "op": "dump_state", "name": "grounding_zombie_state.json" },
    { "op": "quit" }
  ]
}
