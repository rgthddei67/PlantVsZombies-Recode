{
  "commands": [
    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_SPLITPEA", "PLANT_TORCHWOOD"] },
    { "op": "wait_state", "state": "GAME" },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 2000 },
    { "op": "plant", "type": "PLANT_SPLITPEA", "row": 2, "col": 5 },
    { "op": "plant", "type": "PLANT_TORCHWOOD", "row": 2, "col": 3 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 2, "x": 430, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 2, "x": 360, "stationary": true },
    { "op": "wait_seconds", "value": 1.6 },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 190 },
    { "op": "assert_state", "path": "zombies.1.bodyHealth", "equals": 244 },
    { "op": "assert_state", "path": "firePeaSoundRequestCount", "atLeast": 2 },
    { "op": "assert_state", "path": "igniteSoundRequestCount", "atLeast": 2 },
    { "op": "screenshot", "name": "splitpea_backward_fireball_splash.png" },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.nearestZombie.boundsIntersect", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.nearestZombie.centerDxInt", "atLeast": -15, "atMost": 15 },
    { "op": "dump_state", "name": "splitpea_backward_fireball_splash.json" },
    { "op": "quit" }
  ]
}
