{
  "commands": [
    { "op": "goto_level", "level": 37, "background": "ROOF" },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "trigger_lightning" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 0 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.overchargePct", "equals": 0 },

    { "op": "goto_level", "level": 1, "background": "NIGHT_ROOF", "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "assert_state", "path": "weather.intensity", "equals": "CLEAR" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": true },
    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 50 },
    { "op": "wait_seconds", "value": 2.0 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 49 },

    { "op": "goto_level", "level": 46, "resetTestState": true },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_ROOF" },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "wait_seconds", "value": 0.5 },
    { "op": "assert_state", "path": "weather.panelSlidePct", "equals": 100 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "CHARGING" },

    { "op": "set_weather", "intensity": "CLEAR", "duration": 90 },
    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 50 },
    { "op": "wait_seconds", "value": 2.0 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 49 },

    { "op": "set_weather", "intensity": "LIGHT", "duration": 90 },
    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 20 },
    { "op": "wait_seconds", "value": 2.0 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 22 },

    { "op": "set_weather", "intensity": "MEDIUM", "duration": 90 },
    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 30 },
    { "op": "wait_seconds", "value": 2.0 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 34 },

    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 40 },
    { "op": "wait_seconds", "value": 2.0 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 46 },

    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 25 },
    { "op": "trigger_lightning" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 43 },

    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 99 },
    { "op": "trigger_lightning" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "equals": 100 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.overchargePct", "equals": 17 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "WARNING" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.row", "atLeast": 0, "atMost": 4 },

    { "op": "set_night_roof_charge", "phase": "WARNING", "charge": 100, "row": 2, "remaining": 3.5, "overcharge": 4 },
    { "op": "save_level_snapshot", "name": "night_roof_charge_warning" },
    { "op": "reload_level_snapshot", "name": "night_roof_charge_warning" },
    { "op": "wait_seconds", "value": 0.4 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "WARNING" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.row", "equals": 2 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.overchargePct", "atLeast": 5, "atMost": 6 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phaseRemainingMs", "atLeast": 2900, "atMost": 3200 },
    { "op": "assert_state", "path": "weather.panelSlidePct", "equals": 100 },
    { "op": "screenshot", "name": "01_night_roof_charge_warning.png" },

    { "op": "set_weather", "intensity": "CLEAR", "duration": 90 },
    { "op": "set_night_roof_charge", "phase": "DISCHARGING", "charge": 100, "row": 2, "remaining": 0.65, "overcharge": 12 },
    { "op": "save_level_snapshot", "name": "night_roof_charge_discharging" },
    { "op": "reload_level_snapshot", "name": "night_roof_charge_discharging" },
    { "op": "wait_seconds", "value": 0.34 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "DISCHARGING" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.row", "equals": 2 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.overchargePct", "equals": 12 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.dischargeProgressPct", "atLeast": 45, "atMost": 65 },
    { "op": "assert_state", "path": "weather.panelSlidePct", "equals": 100 },
    { "op": "screenshot", "name": "02_night_roof_charge_discharging.png" },
    { "op": "wait_seconds", "value": 0.35 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "CHARGING" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.row", "equals": -1 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.chargePct", "atLeast": 11, "atMost": 12 },
    { "op": "assert_state", "path": "weather.nightRoofCharge.overchargePct", "equals": 0 },
    { "op": "dump_state", "name": "night_roof_charge_state.json" },
    { "op": "quit" }
  ]
}
