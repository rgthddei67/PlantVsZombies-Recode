{
  "commands": [
    { "op": "goto_level", "level": 49, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "spawn_zombie", "type": "ZOMBIE_HIJACKER", "row": 2, "x": 760, "stationary": true },

    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 74.9 },
    { "op": "trigger_lightning" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.hijackerSelectionAttempted", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.executionLine", "equals": 2000 },
    { "op": "trigger_lightning" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.phase", "equals": "WARNING" },
    { "op": "wait_seconds", "value": 7.15, "timeout": 10 },

    { "op": "assert_state", "path": "hijackerResources.executeSoundPlayRequests", "equals": 1 },
    { "op": "assert_state", "path": "weather.hijackerSpawnCooldownWavesRemaining", "equals": 2 },
    { "op": "assert_state", "path": "weather.hijackerSpawnBlockedThisWave", "equals": true },
    { "op": "save_level_snapshot", "name": "hijacker_spawn_cooldown" },
    { "op": "reload_level_snapshot", "name": "hijacker_spawn_cooldown" },
    { "op": "assert_state", "path": "weather.hijackerSpawnCooldownWavesRemaining", "equals": 2 },
    { "op": "assert_state", "path": "weather.hijackerSpawnBlockedThisWave", "equals": true },
    { "op": "spawn_wave_zombie", "type": "ZOMBIE_HIJACKER", "mutationRoll": 50, "row": 0, "x": 900 },
    { "op": "assert_state", "path": "weather.hijackersSpawnedThisWave", "equals": 0 },

    { "op": "summon_next_wave" },
    { "op": "assert_state", "path": "wave", "equals": 1 },
    { "op": "assert_state", "path": "weather.hijackerSpawnCooldownWavesRemaining", "equals": 1 },
    { "op": "assert_state", "path": "weather.hijackerSpawnBlockedThisWave", "equals": true },
    { "op": "spawn_wave_zombie", "type": "ZOMBIE_HIJACKER", "mutationRoll": 50, "row": 1, "x": 900 },
    { "op": "assert_state", "path": "weather.hijackersSpawnedThisWave", "equals": 0 },

    { "op": "summon_next_wave" },
    { "op": "assert_state", "path": "wave", "equals": 2 },
    { "op": "assert_state", "path": "weather.hijackerSpawnCooldownWavesRemaining", "equals": 0 },
    { "op": "assert_state", "path": "weather.hijackerSpawnBlockedThisWave", "equals": true },
    { "op": "spawn_wave_zombie", "type": "ZOMBIE_HIJACKER", "mutationRoll": 50, "row": 2, "x": 900 },
    { "op": "assert_state", "path": "weather.hijackersSpawnedThisWave", "equals": 0 },

    { "op": "summon_next_wave" },
    { "op": "assert_state", "path": "wave", "equals": 3 },
    { "op": "assert_state", "path": "weather.hijackerSpawnCooldownWavesRemaining", "equals": 0 },
    { "op": "assert_state", "path": "weather.hijackerSpawnBlockedThisWave", "equals": false },
    { "op": "spawn_wave_zombie", "type": "ZOMBIE_HIJACKER", "mutationRoll": 50, "row": 3, "x": 900 },
    { "op": "assert_state", "path": "weather.hijackersSpawnedThisWave", "equals": 1 },
    { "op": "screenshot", "name": "01_hijacker_spawn_cooldown_released.png" },
    { "op": "dump_state", "name": "hijacker_spawn_cooldown_state.json" },
    { "op": "quit" }
  ]
}
