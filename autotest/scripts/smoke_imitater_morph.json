{
  "commands": [
    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 20 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "plant", "type": "PLANT_IMITATER", "imitaterTarget": "PLANT_PEASHOOTER", "row": 2, "col": 3 },
    { "op": "wait_seconds", "value": 0.45 },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },
    { "op": "assert_state", "path": "plants.0.id", "equals": 1 },
    { "op": "assert_state", "path": "plants.0.type", "equals": "PLANT_IMITATER" },
    { "op": "assert_state", "path": "plants.0.placementType", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "plants.0.imitaterTarget", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "plants.0.imitaterMorphing", "equals": false },
    { "op": "assert_state", "path": "normalPlantsByCell.2_3.type", "equals": "PLANT_IMITATER" },
    { "op": "screenshot", "name": "imitater_waiting.png" },

    { "op": "save_level_snapshot", "name": "imitater_waiting" },
    { "op": "reload_level_snapshot", "name": "imitater_waiting" },
    { "op": "assert_state", "path": "plants.0.type", "equals": "PLANT_IMITATER" },
    { "op": "assert_state", "path": "plants.0.imitaterTarget", "equals": "PLANT_PEASHOOTER" },
    { "op": "wait_seconds", "value": 1.70 },
    { "op": "assert_state", "path": "plants.0.imitaterMorphing", "equals": true },
    { "op": "assert_state", "path": "plants.0.track", "equals": "anim_explode" },
    { "op": "screenshot", "name": "imitater_morphing.png" },

    { "op": "wait_seconds", "value": 0.80 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ImitaterMorph", "atLeast": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.ImitaterMorph.0.activeParticleCount", "atLeast": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.ImitaterMorph.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "particleEffectsByName.ImitaterMorph.0.renderQuadCount", "equals": 11 },
    { "op": "assert_state", "path": "particleEffectsByName.ImitaterMorph.0.originToRenderCenterDxInt", "atLeast": -12, "atMost": 12 },
    { "op": "assert_state", "path": "particleEffectsByName.ImitaterMorph.0.originToRenderCenterDyInt", "atLeast": -12, "atMost": 12 },
    { "op": "assert_state", "path": "particleEffectsByName.ImitaterMorph.0.nearestPlant.boundsIntersect", "equals": true },
    { "op": "dump_state", "name": "imitater_morph_particle_probe.json" },
    { "op": "screenshot", "name": "imitater_morph_cloud.png" },

    { "op": "wait_seconds", "value": 0.45 },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },
    { "op": "assert_state", "path": "plants.0.id", "equals": 1 },
    { "op": "assert_state", "path": "plants.0.type", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "plants.0.imitated", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_3.type", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "normalPlantsByCell.2_3.imitated", "equals": true },
    { "op": "screenshot", "name": "imitater_transformed_under_cloud.png" },
	{ "op": "wait_seconds", "value": 0.80 },
	{ "op": "assert_state", "path": "particleEffectNameCounts.ImitaterMorph", "equals": 0 },
	{ "op": "assert_state", "path": "plants.0.imitated", "equals": true },
	{ "op": "screenshot", "name": "imitater_transformed_white.png" },

    { "op": "save_level_snapshot", "name": "imitater_transformed" },
    { "op": "reload_level_snapshot", "name": "imitater_transformed" },
    { "op": "assert_state", "path": "plants.0.id", "equals": 1 },
    { "op": "assert_state", "path": "plants.0.type", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "plants.0.imitated", "equals": true },

    { "op": "goto_level", "level": 19 },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 20 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "plant", "type": "PLANT_IMITATER", "imitaterTarget": "PLANT_LILYPAD", "row": 2, "col": 4 },
    { "op": "wait_seconds", "value": 0.20 },
    { "op": "assert_state", "path": "plants.0.placementType", "equals": "PLANT_LILYPAD" },
    { "op": "assert_state", "path": "underPlantsByCell.2_4.type", "equals": "PLANT_IMITATER" },
    { "op": "wait_seconds", "value": 3.35 },
    { "op": "assert_state", "path": "plants.0.type", "equals": "PLANT_LILYPAD" },
    { "op": "assert_state", "path": "plants.0.imitated", "equals": true },
    { "op": "assert_state", "path": "underPlantsByCell.2_4.type", "equals": "PLANT_LILYPAD" },
    { "op": "assert_state", "path": "underPlantsByCell.2_4.imitated", "equals": true },
    { "op": "screenshot", "name": "imitater_lilypad_less_washed.png" },
    { "op": "quit" }
  ]
}
