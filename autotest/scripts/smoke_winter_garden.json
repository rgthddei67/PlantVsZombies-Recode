{
  "commands": [
    { "op": "goto_level", "level": 55 },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },

    { "op": "assert_state", "path": "levelName", "equals": "关卡 7-1" },
    { "op": "assert_state", "path": "background", "equals": "WINTER_GARDEN" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "columns", "equals": 9 },
    { "op": "assert_state", "path": "winterGardenBackgroundLoaded", "equals": true },
    { "op": "assert_state", "path": "winterFrostOverlayLoaded", "equals": true },
    { "op": "assert_state", "path": "winterThermometerLoaded", "equals": true },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": true },
    { "op": "assert_state", "path": "weather.winter.thermometerVisible", "equals": true },
    { "op": "assert_state", "path": "weather.winter.thermometerMinimumTenths", "equals": -120 },
    { "op": "assert_state", "path": "weather.winter.thermometerMaximumTenths", "equals": 60 },
    { "op": "assert_state", "path": "weather.winter.thermometerFreezingTenths", "equals": 0 },
    { "op": "assert_state", "path": "weather.panelHeight", "equals": 72 },
    { "op": "assert_state", "path": "mowerCount", "equals": 3 },
    { "op": "assert_state", "path": "mowers.0.row", "equals": 2 },
    { "op": "assert_state", "path": "mowers.1.row", "equals": 3 },
    { "op": "assert_state", "path": "mowers.2.row", "equals": 4 },
    { "op": "assert_state", "path": "weather.winter.typhoonSupported", "equals": false },
    { "op": "assert_state", "path": "weather.typhoonChancePct", "equals": 0 },

    { "op": "set_cold_wave", "phase": "CALM", "temperature": 6, "remaining": 30 },
    { "op": "assert_state", "path": "weather.winter.frozenColumns", "equals": 0 },
    { "op": "assert_state", "path": "weather.winter.frostVisualColumnsOn1000", "equals": 0 },
    { "op": "assert_state", "path": "weather.winter.thermometerFillPct", "equals": 100 },
    { "op": "assert_state", "path": "weather.winter.coldWaveForecastActive", "equals": false },
    { "op": "assert_state", "path": "weather.winter.coldWaveDisplayText", "equals": "" },
    { "op": "assert_state", "path": "weather.panelHeight", "equals": 72 },
    { "op": "screenshot", "name": "winter_garden_temperature_warm.png" },

    { "op": "set_cold_wave", "phase": "CALM", "temperature": 6, "remaining": 19 },
    { "op": "wait_seconds", "value": 0.4, "timeout": 2 },
    { "op": "assert_state", "path": "weather.winter.coldWaveForecastActive", "equals": true },
    { "op": "assert_state", "path": "weather.winter.coldWaveActive", "equals": false },
    { "op": "assert_state", "path": "weather.winter.coldWaveDisplayText", "equals": "寒潮预报（19秒）：气温将降至 -12°C" },
    { "op": "assert_state", "path": "weather.forecastFailureOn", "equals": false },
    { "op": "assert_state", "path": "weather.panelHeight", "equals": 102 },
    { "op": "screenshot", "name": "winter_garden_cold_wave_forecast.png" },

    { "op": "set_cold_wave", "phase": "COOLING", "temperature": 6, "remaining": 20 },
    { "op": "set_timescale", "value": 5.0 },
    { "op": "wait_seconds", "value": 5.0, "timeout": 3 },
    { "op": "set_timescale", "value": 0.0 },
    { "op": "assert_state", "path": "weather.winter.temperatureTenths", "atLeast": 14, "atMost": 16 },
    { "op": "assert_state", "path": "weather.winter.phaseRemainingMs", "atLeast": 14800, "atMost": 15100 },

    { "op": "set_cold_wave", "phase": "THAWING", "temperature": -12, "remaining": 32 },
    { "op": "set_timescale", "value": 5.0 },
    { "op": "wait_seconds", "value": 4.0, "timeout": 3 },
    { "op": "set_timescale", "value": 0.0 },
    { "op": "assert_state", "path": "weather.winter.temperatureTenths", "atLeast": -99, "atMost": -97 },
    { "op": "assert_state", "path": "weather.winter.phaseRemainingMs", "atLeast": 27800, "atMost": 28100 },

    { "op": "set_cold_wave", "phase": "COOLING", "temperature": 1, "remaining": 14.444 },
    { "op": "assert_state", "path": "weather.winter.frozenColumns", "equals": 0 },
    { "op": "assert_state", "path": "weather.winter.frostVisualColumnsOn1000", "equals": 500 },
    { "op": "set_cold_wave", "phase": "COOLING", "temperature": -1, "remaining": 12.222 },
    { "op": "assert_state", "path": "weather.winter.frozenColumns", "equals": 1 },
    { "op": "assert_state", "path": "weather.winter.frostVisualColumnsOn1000", "equals": 1500 },
    { "op": "screenshot", "name": "winter_garden_frost_midway.png" },
    { "op": "set_timescale", "value": 1.0 },

    { "op": "set_cold_wave", "phase": "COOLING", "temperature": 0, "remaining": 13.333 },
    { "op": "assert_state", "path": "weather.winter.frozenColumns", "equals": 1 },
    { "op": "assert_state", "path": "weather.winter.frostVisualColumnsOn1000", "equals": 1000 },
    { "op": "assert_state", "path": "weather.winter.firstFrozenColumn", "equals": 8 },
    { "op": "assert_state", "path": "weather.winter.thermometerFillPct", "equals": 67 },
    { "op": "assert_state", "path": "weather.winter.coldWaveDisplayText", "equals": "寒潮实况：降温中（14秒）" },
    { "op": "screenshot", "name": "winter_garden_frost_frontier.png" },

    { "op": "set_cold_wave", "phase": "CALM", "temperature": 6, "remaining": 30 },
    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 2, "col": 8 },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },

    { "op": "set_cold_wave", "phase": "COLD", "temperature": -12, "remaining": 30 },
    { "op": "assert_state", "path": "weather.winter.temperatureTenths", "equals": -120 },
    { "op": "assert_state", "path": "weather.winter.thermometerFillPct", "equals": 0 },
    { "op": "assert_state", "path": "weather.winter.frozenColumns", "equals": 6 },
    { "op": "assert_state", "path": "weather.winter.firstFrozenColumn", "equals": 3 },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },
    { "op": "assert_can_plant", "type": "PLANT_PEASHOOTER", "row": 1, "col": 8, "expected": false },
    { "op": "assert_can_plant", "type": "PLANT_PEASHOOTER", "row": 1, "col": 2, "expected": true },

    { "op": "set_weather", "intensity": "HEAVY", "duration": 60 },
    { "op": "wait_seconds", "value": 1.2, "timeout": 3 },
    { "op": "assert_state", "path": "weather.intensity", "equals": "HEAVY" },
    { "op": "assert_state", "path": "weather.winter.snowing", "equals": true },
    { "op": "assert_state", "path": "weather.winter.precipitationEffect", "equals": "SnowHeavy" },
    { "op": "assert_state", "path": "particleEffectNameCounts.SnowHeavy", "atLeast": 1 },
    { "op": "assert_state", "path": "weather.typhoonStrength", "equals": "NONE" },
    { "op": "assert_state", "path": "weather.lightningRemaining", "equals": 0 },
    { "op": "assert_state", "path": "weather.rainSoundPlaying", "equals": false },
    { "op": "screenshot", "name": "winter_garden_heavy_snow.png" },

    { "op": "save_level_snapshot", "name": "winter_garden_cold_wave" },
    { "op": "set_cold_wave", "phase": "CALM", "temperature": 6, "remaining": 30 },
    { "op": "wait_seconds", "value": 0.2, "timeout": 2 },
    { "op": "assert_state", "path": "weather.winter.snowing", "equals": false },
    { "op": "assert_state", "path": "weather.winter.precipitationEffect", "equals": "RainHeavy" },
    { "op": "reload_level_snapshot", "name": "winter_garden_cold_wave" },
    { "op": "wait_seconds", "value": 0.4, "timeout": 3 },
    { "op": "assert_state", "path": "background", "equals": "WINTER_GARDEN" },
    { "op": "assert_state", "path": "weather.winter.phase", "equals": "COLD" },
    { "op": "assert_state", "path": "weather.winter.temperatureTenths", "equals": -120 },
    { "op": "assert_state", "path": "weather.winter.snowing", "equals": true },
    { "op": "assert_state", "path": "weather.winter.precipitationEffect", "equals": "SnowHeavy" },
    { "op": "assert_state", "path": "weather.typhoonStrength", "equals": "NONE" },
    { "op": "assert_state", "path": "mowerCount", "equals": 3 },
    { "op": "assert_state", "path": "mowers.0.row", "equals": 2 },
    { "op": "screenshot", "name": "winter_garden_cold_wave_reloaded.png" },
    { "op": "dump_state", "name": "winter_garden_state.json" },
    { "op": "quit" }
  ]
}
