{
  "commands": [
    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": ["PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "assert_state", "path": "pogoResources.reanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "pogoResources.brokenArmLoaded", "equals": true },
    { "op": "assert_state", "path": "pogoResources.damagedHandsLoaded", "equals": true },
    { "op": "assert_state", "path": "pogoResources.damagedStickLoaded", "equals": true },
    { "op": "assert_state", "path": "pogoResources.damagedStick2Loaded", "equals": true },
    { "op": "assert_state", "path": "pogoResources.headParticleLoaded", "equals": true },
    { "op": "assert_state", "path": "pogoResources.pogoParticleLoaded", "equals": true },

    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_POGO", "row": 0, "x": 700 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_POGO" },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 500 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "BOUNCING" },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": true },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": false },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_pogo" },
    { "op": "assert_state", "path": "zombies.0.pogoVisualLiftOn1000", "atLeast": 9000 },
    { "op": "screenshot", "name": "01_pogo_bouncing.png" },
	{ "op": "set_pogo_bounce_remaining", "row": 0, "value": 0.333333 },
	{ "op": "wait_frames", "value": 2 },
	{ "op": "assert_state", "path": "zombies.0.pogoAltitudeOn1000", "atMost": 34000 },
	{ "op": "screenshot", "name": "01b_pogo_faster_descent.png" },

    { "op": "set_pogo_bounce_remaining", "row": 0, "value": 0.01 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "HIGH_BOUNCE" },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": false },
    { "op": "save_level_snapshot", "name": "pogo_high_bounce" },
    { "op": "reload_level_snapshot", "name": "pogo_high_bounce" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "HIGH_BOUNCE" },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": true },

    { "op": "set_pogo_bounce_remaining", "row": 0, "value": 0.01 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "FORWARD_BOUNCE" },
    { "op": "assert_state", "path": "zombies.0.pogoForwardDistanceOn1000", "atLeast": 30000 },
    { "op": "assert_state", "path": "zombies.0.pogoJumpBlockChecked", "equals": false },
    { "op": "screenshot", "name": "02_pogo_forward_bounce.png" },
    { "op": "wait_seconds", "value": 0.20, "timeout": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": false },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_eat" },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombiePogo", "equals": 1 },
    { "op": "screenshot", "name": "03_tallnut_breaks_pogo.png" },
    { "op": "save_level_snapshot", "name": "pogo_eating_without_stick" },
    { "op": "reload_level_snapshot", "name": "pogo_eating_without_stick" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "wait_seconds", "value": 1.4, "timeout": 4 },
    { "op": "assert_state", "path": "plants.0.health", "atMost": 8900 },

    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 170, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 330 },
    { "op": "assert_state", "path": "zombies.0.hasArm", "equals": false },
    { "op": "assert_state", "path": "particleEffectNameCounts.PogoArmOff", "equals": 1 },
    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 170, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 160 },
    { "op": "assert_state", "path": "zombies.0.hasHead", "equals": false },
    { "op": "assert_state", "path": "zombies.0.pogoGlassesVisible", "equals": false },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombiePogoHeadOff", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.ZombiePogoHeadOff.0.activeParticleCount", "atLeast": 2 },
    { "op": "screenshot", "name": "04_pogo_dismembered.png" },
    { "op": "wait_seconds", "value": 2.7, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.isDying", "equals": true },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_death" },
    { "op": "screenshot", "name": "05_pogo_death.png" },
    { "op": "wait_seconds", "value": 2.7, "timeout": 5 },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_POGO", "row": 1, "x": 700 },
    { "op": "damage_zombie", "row": 1, "index": 0, "damage": 340, "source": "OTHER" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": false },
    { "op": "assert_state", "path": "zombies.0.hasArm", "equals": false },
    { "op": "assert_state", "path": "zombies.0.hasHead", "equals": false },
    { "op": "assert_state", "path": "particleEffectNameCounts.PogoArmOff", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombiePogo", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombiePogoHeadOff", "equals": 1 },
    { "op": "screenshot", "name": "06_head_loss_breaks_active_pogo.png" },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_POTATOMINE", "PLANT_CHOMPER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_POTATOMINE", "row": 2, "col": 5 },
    { "op": "set_timescale", "value": 20.0 },
    { "op": "wait_seconds", "value": 23.0, "timeout": 4 },
    { "op": "set_timescale", "value": 1.0 },
    { "op": "assert_state", "path": "plants.0.track", "equals": "anim_armed" },
    { "op": "spawn_zombie", "type": "ZOMBIE_POGO", "row": 2, "x": 700 },
    { "op": "plant", "type": "PLANT_CHOMPER", "row": 3, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_POGO", "row": 3, "x": 700 },
    { "op": "wait_seconds", "value": 2.4, "timeout": 5 },
    { "op": "assert_state", "path": "plantCount", "equals": 2 },
    { "op": "assert_state", "path": "zombieCount", "equals": 2 },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": true },
    { "op": "assert_state", "path": "zombies.1.hasPogo", "equals": true },
    { "op": "screenshot", "name": "07_pogo_ground_plant_immunity.png" },

    { "op": "dump_state", "name": "pogo_zombie_final_state.json" },
    { "op": "quit" }
  ]
}
