    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerPhase", "equals": "READY" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerCommittedDisruptionMask", "equals": 0 },
    { "op": "assert_state", "path": "weather.forecastDisrupted", "equals": false },
    { "op": "assert_state", "path": "weather.forecastReady", "equals": false },
    { "op": "set_weather_forecast", "forecast": "HEAVY", "actual": "MEDIUM", "revealIn": 10.0 },
