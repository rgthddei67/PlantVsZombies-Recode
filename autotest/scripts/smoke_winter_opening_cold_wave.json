{
  "commands": [
    { "op": "goto_level", "level": 62, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"], "timeout": 20 },
    { "op": "wait_state", "state": "GAME", "timeout": 20 },
    { "op": "set_spawn_paused", "value": true },

    { "op": "assert_state", "path": "levelName", "equals": "关卡 7-8" },
    { "op": "assert_state", "path": "background", "equals": "WINTER_GARDEN" },
    { "op": "assert_state", "path": "weather.winter.openingColdWaveScript", "equals": true },
    { "op": "assert_state", "path": "weather.winter.openingColdWavePlanInitialized", "equals": true },
    { "op": "assert_state", "path": "weather.winter.phase", "equals": "CALM" },
    { "op": "assert_state", "path": "weather.winter.coldWaveForecastActive", "equals": true },
    { "op": "assert_state", "path": "weather.winter.coldWaveActive", "equals": false },
    { "op": "assert_state", "path": "weather.winter.strength", "equals": "STRONG" },
    { "op": "assert_state", "path": "weather.winter.targetTemperatureTenths", "equals": -120 },
    { "op": "assert_state", "path": "weather.winter.coolingDurationMs", "equals": 15000 },
    { "op": "assert_state", "path": "weather.winter.holdDurationMs", "equals": 50000 },
    { "op": "assert_state", "path": "weather.winter.thawDurationMs", "equals": 30000 },
    { "op": "assert_state", "path": "weather.winter.frostVariant", "equals": 1 },
    { "op": "assert_state", "path": "weather.winter.phaseRemainingMs", "atLeast": 11000, "atMost": 12000 },
    { "op": "wait_seconds", "value": 0.4, "timeout": 2 },
    { "op": "assert_state", "path": "weather.winter.coldWaveDisplayText", "equals": "强寒潮预报（12秒）：最低 -12°C" },
    { "op": "screenshot", "name": "7_8_opening_cold_wave_forecast.png" },

    { "op": "set_timescale", "value": 5.0 },
    { "op": "wait_seconds", "value": 13.0, "timeout": 5 },
    { "op": "set_timescale", "value": 0.0 },
    { "op": "assert_state", "path": "weather.winter.phase", "equals": "COOLING" },
    { "op": "assert_state", "path": "weather.winter.coldWaveForecastActive", "equals": false },
    { "op": "assert_state", "path": "weather.winter.coldWaveActive", "equals": true },
    { "op": "assert_state", "path": "weather.winter.phaseRemainingMs", "atLeast": 13000, "atMost": 15000 },
    { "op": "save_level_snapshot", "name": "7_8_opening_cold_wave" },
    { "op": "reload_level_snapshot", "name": "7_8_opening_cold_wave" },
    { "op": "assert_state", "path": "weather.winter.openingColdWavePlanInitialized", "equals": true },
    { "op": "assert_state", "path": "weather.winter.phase", "equals": "COOLING" },
    { "op": "assert_state", "path": "weather.winter.strength", "equals": "STRONG" },
    { "op": "assert_state", "path": "weather.winter.targetTemperatureTenths", "equals": -120 },
    { "op": "assert_state", "path": "weather.winter.coolingDurationMs", "equals": 15000 },
    { "op": "assert_state", "path": "weather.winter.holdDurationMs", "equals": 50000 },
    { "op": "assert_state", "path": "weather.winter.thawDurationMs", "equals": 30000 },
    { "op": "assert_state", "path": "weather.winter.frostVariant", "equals": 1 },

    { "op": "set_timescale", "value": 20.0 },
    { "op": "wait_seconds", "value": 100.0, "timeout": 8 },
    { "op": "set_timescale", "value": 0.0 },
    { "op": "assert_state", "path": "weather.winter.phase", "equals": "CALM" },
    { "op": "assert_state", "path": "weather.winter.coldWaveForecastActive", "equals": false },
    { "op": "assert_state", "path": "weather.winter.coldWaveActive", "equals": false },
    { "op": "assert_state", "path": "weather.intensity", "equals": "LIGHT" },
    { "op": "assert_state", "path": "weather.winter.targetTemperatureTenths", "atLeast": -120, "atMost": -40 },
    { "op": "assert_state", "path": "weather.winter.coolingDurationMs", "atLeast": 15000, "atMost": 25000 },
    { "op": "assert_state", "path": "weather.winter.holdDurationMs", "atLeast": 35000, "atMost": 75000 },
    { "op": "assert_state", "path": "weather.winter.thawDurationMs", "atLeast": 24000, "atMost": 44000 },
    { "op": "assert_state", "path": "weather.winter.phaseRemainingMs", "atLeast": 28000, "atMost": 60000 },
    { "op": "screenshot", "name": "7_8_opening_cold_wave_recovered.png" },

    { "op": "goto_level", "level": 63, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"], "timeout": 20 },
    { "op": "wait_state", "state": "GAME", "timeout": 20 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "assert_state", "path": "levelName", "equals": "关卡 7-9" },
    { "op": "assert_state", "path": "weather.winter.openingColdWaveScript", "equals": true },
    { "op": "assert_state", "path": "weather.winter.openingColdWavePlanInitialized", "equals": true },
    { "op": "assert_state", "path": "weather.winter.phase", "equals": "CALM" },
    { "op": "assert_state", "path": "weather.winter.coldWaveForecastActive", "equals": true },
    { "op": "assert_state", "path": "weather.winter.strength", "equals": "STRONG" },
    { "op": "assert_state", "path": "weather.winter.targetTemperatureTenths", "equals": -120 },
    { "op": "assert_state", "path": "weather.winter.coolingDurationMs", "equals": 15000 },
    { "op": "assert_state", "path": "weather.winter.holdDurationMs", "equals": 50000 },
    { "op": "assert_state", "path": "weather.winter.thawDurationMs", "equals": 30000 },
    { "op": "assert_state", "path": "weather.winter.frostVariant", "equals": 2 },
    { "op": "screenshot", "name": "7_9_opening_cold_wave_forecast.png" },

    { "op": "dump_state", "name": "state.json" },
    { "op": "quit" }
  ]
}
