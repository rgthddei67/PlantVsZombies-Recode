    { "op": "assert_can_target", "plantType": "PLANT_PEASHOOTER", "plantRow": 0, "plantCol": 2, "zombieRow": 0, "zombieIndex": 0, "expected": false },

    { "op": "set_fog_dispersal", "value": 0.42 },
    { "op": "set_timescale", "value": 0.0 },
