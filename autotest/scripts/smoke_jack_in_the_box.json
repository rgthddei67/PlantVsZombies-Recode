{
  "commands": [
    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": ["PLANT_WALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },

    { "op": "plant", "type": "PLANT_WALLNUT", "row": 0, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_JACK_IN_THE_BOX", "row": 0, "x": 700, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 1, "x": 700, "stationary": true },
    { "op": "charm_zombie", "row": 1, "index": 0 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 1, "x": 700, "stationary": true },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "jackZombieCount", "equals": 1 },
    { "op": "assert_state", "path": "jack.type", "equals": "ZOMBIE_JACK_IN_THE_BOX" },
    { "op": "assert_state", "path": "jack.bodyHealth", "equals": 500 },
    { "op": "assert_state", "path": "jack.jackPhase", "equals": "RUNNING" },
    { "op": "assert_state", "path": "jack.isEating", "equals": true },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": true },
    { "op": "assert_state", "path": "jackBoingSoundRequestCount", "equals": 0 },
    { "op": "assert_state", "path": "jackSurpriseSoundRequestCount", "equals": 0 },
    { "op": "assert_state", "path": "jackExplosionSoundRequestCount", "equals": 0 },
    { "op": "set_jack_pop_countdown", "row": 0, "value": 5.0 },
    { "op": "save_level_snapshot", "name": "jack_running" },
    { "op": "reload_level_snapshot", "name": "jack_running" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "jack.jackPhase", "equals": "RUNNING" },
    { "op": "assert_state", "path": "jack.jackPopCountdownMs", "atLeast": 4800, "atMost": 5000 },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": true },
    { "op": "assert_state", "path": "jackBoingSoundRequestCount", "equals": 0 },
    { "op": "assert_state", "path": "jackSurpriseSoundRequestCount", "equals": 0 },
    { "op": "assert_state", "path": "jackExplosionSoundRequestCount", "equals": 0 },

    { "op": "set_jack_pop_countdown", "row": 0, "value": 1.0 },
    { "op": "wait_seconds", "value": 0.65, "timeout": 3 },
    { "op": "assert_state", "path": "jack.jackPhase", "equals": "RUNNING" },
    { "op": "assert_state", "path": "plants.0.health", "atMost": 3999 },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": true },
    { "op": "screenshot", "name": "01_eating_with_music_box.png" },

    { "op": "wait_seconds", "value": 0.4, "timeout": 3 },
    { "op": "assert_state", "path": "jack.jackPhase", "equals": "POPPING" },
    { "op": "assert_state", "path": "jack.track", "equals": "anim_pop" },
    { "op": "assert_state", "path": "jack.isEating", "equals": false },
    { "op": "assert_state", "path": "jackBoingSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": false },
    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 499, "source": "OTHER" },
    { "op": "wait_seconds", "value": 0.18, "timeout": 2 },
    { "op": "assert_state", "path": "jack.bodyHealth", "equals": 500 },
    { "op": "screenshot", "name": "02_anim_pop_boing.png" },

    { "op": "wait_seconds", "value": 0.3, "timeout": 3 },
    { "op": "assert_state", "path": "jack.jackPhase", "equals": "POPPING" },
    { "op": "assert_state", "path": "jack.jackSurprisePlayed", "equals": true },
    { "op": "assert_state", "path": "jackSurpriseSoundRequestCount", "equals": 1 },
    { "op": "screenshot", "name": "03_anim_pop_surprise.png" },

    { "op": "wait_seconds", "value": 0.35, "timeout": 3 },
    { "op": "assert_state", "path": "jackZombieCount", "equals": 0 },
    { "op": "assert_state", "path": "zombieCount", "equals": 1 },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_NORMAL" },
    { "op": "assert_state", "path": "zombies.0.mindControlled", "equals": false },
    { "op": "assert_state", "path": "plantCount", "equals": 0 },
    { "op": "assert_state", "path": "charredZombieCount", "equals": 1 },
    { "op": "assert_state", "path": "jackExplosionSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.JackExplode", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.JackExplode.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "particleEffectsByName.JackExplode.0.renderQuadCount", "atLeast": 20 },
    { "op": "assert_state", "path": "particleEffectsByName.JackExplode.0.worldBounds.widthInt", "atLeast": 200 },
    { "op": "assert_state", "path": "particleEffectsByName.JackExplode.0.worldBounds.heightInt", "atLeast": 200 },
    { "op": "screenshot", "name": "04_jack_purple_explosion.png" },
    { "op": "wait_seconds", "value": 1.4, "timeout": 3 },
    { "op": "assert_state", "path": "particleEffectNameCounts.JackExplode", "equals": 0 },
    { "op": "kill_zombie", "row": 1, "index": 0 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },

    { "op": "spawn_zombie", "type": "ZOMBIE_JACK_IN_THE_BOX", "row": 2, "x": 700, "stationary": true },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": true },
    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 170, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "jack.bodyHealth", "equals": 330 },
    { "op": "assert_state", "path": "jack.hasArm", "equals": false },
    { "op": "assert_state", "path": "limbsPopSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieJackboxArmOff", "equals": 1 },
    { "op": "screenshot", "name": "05_jack_arm_particle.png" },
    { "op": "save_level_snapshot", "name": "jack_lost_arm" },
    { "op": "reload_level_snapshot", "name": "jack_lost_arm" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "jack.hasArm", "equals": false },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": true },
    { "op": "assert_state", "path": "limbsPopSoundRequestCount", "equals": 1 },
    { "op": "screenshot", "name": "06_jack_lower2_arm_after_reload.png" },

    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 170, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "jack.bodyHealth", "atLeast": 159, "atMost": 160 },
    { "op": "assert_state", "path": "jack.hasHead", "equals": false },
    { "op": "assert_state", "path": "jack.jackHead1Visible", "equals": false },
    { "op": "assert_state", "path": "jack.jackHead2Visible", "equals": false },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": false },
    { "op": "assert_state", "path": "limbsPopSoundRequestCount", "equals": 2 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieHeadOff", "equals": 1 },
    { "op": "screenshot", "name": "07_jack_head_particle.png" },
    { "op": "wait_seconds", "value": 2.4, "timeout": 4 },
    { "op": "assert_state", "path": "jackZombieCount", "equals": 1 },
    { "op": "wait_seconds", "value": 0.3, "timeout": 3 },
    { "op": "assert_state", "path": "jack.track", "equals": "anim_death" },
    { "op": "assert_state", "path": "jack.isDying", "equals": true },
    { "op": "screenshot", "name": "08_jack_death_frame.png" },
    { "op": "wait_seconds", "value": 1.1, "timeout": 3 },
    { "op": "assert_state", "path": "jackZombieCount", "equals": 0 },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },

    { "op": "plant", "type": "PLANT_WALLNUT", "row": 3, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_JACK_IN_THE_BOX", "row": 3, "x": 700, "stationary": true },
    { "op": "charm_zombie", "row": 3, "index": 0 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 4, "x": 700, "stationary": true },
    { "op": "charm_zombie", "row": 4, "index": 0 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 4, "x": 700, "stationary": true },
    { "op": "set_jack_pop_countdown", "row": 3, "value": 0.5 },
    { "op": "wait_seconds", "value": 0.55, "timeout": 3 },
    { "op": "assert_state", "path": "jack.mindControlled", "equals": true },
    { "op": "assert_state", "path": "jack.jackPhase", "equals": "POPPING" },
    { "op": "wait_seconds", "value": 0.6, "timeout": 3 },
    { "op": "assert_state", "path": "jackZombieCount", "equals": 0 },
    { "op": "assert_state", "path": "zombieCount", "equals": 1 },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_NORMAL" },
    { "op": "assert_state", "path": "zombies.0.mindControlled", "equals": true },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },
    { "op": "assert_state", "path": "charredZombieCount", "equals": 1 },
    { "op": "assert_state", "path": "jackExplosionSoundRequestCount", "equals": 2 },
    { "op": "assert_state", "path": "particleEffectNameCounts.JackExplode", "equals": 1 },
    { "op": "screenshot", "name": "09_charmed_jack_spares_plant.png" },

    { "op": "dump_state", "name": "jack_in_the_box_final_state.json" },
    { "op": "set_spawn_paused", "value": false },
    { "op": "quit" }
  ]
}
