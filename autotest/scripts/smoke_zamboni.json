    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 2, "col": 7 },
    { "op": "spawn_zombie", "type": "ZOMBIE_ZAMBONI", "row": 2, "x": 720, "slowed": true },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_ZAMBONI" },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 1350 },
    { "op": "assert_state", "path": "zombies.0.bodyMaxHealth", "equals": 1350 },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_drive" },
    { "op": "assert_state", "path": "zombies.0.slowed", "equals": false },
    { "op": "charm_zombie", "row": 2, "index": 0 },
    { "op": "assert_state", "path": "zombies.0.mindControlled", "equals": false },
    { "op": "wait_seconds", "value": 0.15 },
    { "op": "assert_state", "path": "plants.0.squished", "equals": true },
    { "op": "assert_state", "path": "iceTrails.2.active", "equals": true },
