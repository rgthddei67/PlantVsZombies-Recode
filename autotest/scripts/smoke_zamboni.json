    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 450, "source": "OTHER" },
    { "op": "wait_seconds", "value": 0.1 },
    { "op": "assert_state", "path": "zombies.0.zamboniDamageStage", "equals": 2 },
    { "op": "assert_state", "path": "zamboniSmokeParticleCount", "atLeast": 1 },
    { "op": "screenshot", "name": "zamboni_damage2_smoke.png" },
    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 450, "source": "OTHER" },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },
    { "op": "assert_state", "path": "zamboniCharredCount", "equals": 0 },
    { "op": "assert_state", "path": "zamboniExplosionParticleCount", "atLeast": 1 },
    { "op": "wait_frames", "value": 2 },
    { "op": "screenshot", "name": "zamboni_normal_death_particles.png" },
    { "op": "wait_frames", "value": 2 },
    { "op": "dump_state", "name": "zamboni_normal_death_particles.json" },

    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": ["PLANT_JALAPENO"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_timescale", "value": 1.0 },
    { "op": "set_sun", "value": 9000 },
    { "op": "spawn_zombie", "type": "ZOMBIE_ZAMBONI", "row": 1, "x": 720 },
