    { "op": "assert_state", "path": "zombieCount", "equals": 0 },
    { "op": "assert_state", "path": "zamboniCharredCount", "equals": 1 },
    { "op": "assert_state", "path": "zamboniExplosionParticleCount", "equals": 0 },
    { "op": "assert_state", "path": "iceTrails.1.remainingMs", "atMost": 200 },
    { "op": "screenshot", "name": "zamboni_charred_frame53_residue.png" },
    { "op": "dump_state", "name": "zamboni_charred_frame53_residue.json" },
    { "op": "wait_seconds", "value": 0.25 },
    { "op": "assert_state", "path": "iceTrails.1.active", "equals": false },
    { "op": "assert_can_plant", "type": "PLANT_JALAPENO", "row": 1, "col": 8, "expected": true },
