{
  "commands": [
    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": ["PLANT_WALLNUT", "PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },

    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 5 },
    { "op": "wait_seconds", "value": 0.55, "timeout": 3 },
    { "op": "assert_state", "path": "plants.0.type", "equals": "PLANT_TALLNUT" },
    { "op": "assert_state", "path": "plants.0.health", "equals": 8000 },
    { "op": "assert_state", "path": "plants.0.maxHealth", "equals": 8000 },
    { "op": "assert_state", "path": "plants.0.track", "equals": "anim_idle" },
    { "op": "assert_state", "path": "plants.0.nutDamageStage", "equals": 0 },
    { "op": "screenshot", "name": "01_tallnut_intact.png" },
    { "op": "assert_state", "path": "animatedObjectsByTag.Plant.0.renderProbeReady", "equals": true },

    { "op": "damage_plant", "row": 0, "col": 5, "damage": 2800, "source": "ZOMBIE" },
    { "op": "wait_seconds", "value": 0.55, "timeout": 3 },
    { "op": "assert_state", "path": "plants.0.health", "equals": 5200 },
    { "op": "assert_state", "path": "plants.0.nutDamageStage", "equals": 1 },
    { "op": "screenshot", "name": "02_tallnut_cracked1.png" },
    { "op": "assert_state", "path": "particleEffectNameCounts.WallnutEatLarge", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.WallnutEatLarge.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "particleEffectsByName.WallnutEatLarge.0.nearestPlant.type", "equals": "PLANT_TALLNUT" },

    { "op": "wait_seconds", "value": 1.1, "timeout": 3 },
    { "op": "damage_plant", "row": 0, "col": 5, "damage": 2800, "source": "ZOMBIE" },
    { "op": "wait_seconds", "value": 0.55, "timeout": 3 },
    { "op": "assert_state", "path": "plants.0.health", "equals": 2400 },
    { "op": "assert_state", "path": "plants.0.nutDamageStage", "equals": 2 },
    { "op": "screenshot", "name": "03_tallnut_cracked2.png" },
    { "op": "assert_state", "path": "particleEffectNameCounts.WallnutEatLarge", "equals": 1 },

    { "op": "save_level_snapshot", "name": "tallnut_cracked" },
    { "op": "reload_level_snapshot", "name": "tallnut_cracked" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "plants.0.health", "equals": 2400 },
    { "op": "assert_state", "path": "plants.0.nutDamageStage", "equals": 2 },
    { "op": "assert_state", "path": "particleEffectNameCounts.WallnutEatLarge", "equals": 0 },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_POLEVAULTER", "row": 0, "x": 760 },
    { "op": "wait_frames", "value": 5 },
    { "op": "assert_state", "path": "zombies.0.vaultState", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.hasVaulted", "equals": true },
    { "op": "assert_state", "path": "zombies.0.lastVaultDistanceOn1000", "equals": 0 },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "plants.0.eaterCount", "equals": 1 },
    { "op": "screenshot", "name": "04_normal_pole_blocked.png" },
    { "op": "assert_state", "path": "particleEffectNameCounts.TallNutBlock", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.TallNutBlock.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "particleEffectsByName.TallNutBlock.0.nearestPlant.type", "equals": "PLANT_TALLNUT" },

    { "op": "wait_seconds", "value": 1.4, "timeout": 4 },
    { "op": "screenshot", "name": "05_tallnut_chew_particles.png" },
    { "op": "assert_state", "path": "plants.0.health", "atMost": 7999 },
    { "op": "assert_state", "path": "particleEffectNameCounts.WallnutEatSmall", "atLeast": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.WallnutEatSmall.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "particleEffectsByName.WallnutEatSmall.0.nearestPlant.type", "equals": "PLANT_TALLNUT" },
    { "op": "dump_state", "name": "tallnut_final_state.json" },
    { "op": "quit" }
  ]
}
