{
  "commands": [
    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME" },
    { "op": "set_spawn_paused", "value": true },
    { "op": "plant", "type": "PLANT_TORCHWOOD", "row": 2, "col": 4 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 2, "x": 700, "stationary": true },
    { "op": "spawn_bullet", "type": "BULLET_FIREBALL", "row": 2, "x": 700, "y": 308, "velocityX": 0 },
    { "op": "wait_frames", "value": 3 },
    { "op": "screenshot", "name": "fireball_impact_probe.png" },
    { "op": "assert_state", "path": "animatedObjectTagCounts.Plant", "equals": 1 },
    { "op": "assert_state", "path": "animatedObjectsByTag.Plant.0.objectType", "equals": "PLANT" },
    { "op": "assert_state", "path": "animatedObjectsByTag.Plant.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.Plant.0.worldBounds.widthInt", "atLeast": 1 },
    { "op": "assert_state", "path": "animatedObjectTagCounts.Zombie", "equals": 1 },
    { "op": "assert_state", "path": "animatedObjectsByTag.Zombie.0.objectType", "equals": "ZOMBIE" },
    { "op": "assert_state", "path": "animatedObjectsByTag.Zombie.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.Zombie.0.worldBounds.heightInt", "atLeast": 1 },
    { "op": "assert_state", "path": "animatedObjectTagCounts.FireballImpact", "equals": 1 },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.animation", "equals": "Fire" },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.renderQuadCount", "atLeast": 1 },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.renderBaseMatchesVisualPosition", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.renderPivotMatchesVisualBase", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.renderScaleXOn1000", "equals": 700 },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.renderScaleYOn1000", "equals": 400 },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.worldBounds.widthInt", "atLeast": 1 },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.worldBounds.heightInt", "atLeast": 1 },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.nearestZombie.boundsIntersect", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.nearestZombie.centerDxInt", "atLeast": -100, "atMost": 100 },
    { "op": "assert_state", "path": "animatedObjectsByTag.FireballImpact.0.nearestZombie.centerDyInt", "atLeast": -100, "atMost": 100 },
    { "op": "dump_state", "name": "fireball_impact_probe.json" },
    { "op": "quit" }
  ]
}
