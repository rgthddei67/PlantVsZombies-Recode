{
  "commands": [
    { "op": "goto_level", "level": 57, "background": "POLAR_NIGHT_SNOWFIELD", "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },

    { "op": "set_polar_environment", "temperature": -14, "humidity": 61, "wind": 22, "direction": "UP", "phase": "DANGER_HOLD" },
    { "op": "wait_seconds", "value": 0.2 },
    { "op": "assert_state", "path": "weather.polarNight.windVisualPct", "atLeast": 5, "atMost": 25 },
    { "op": "screenshot", "name": "01_wind_gradual_onset.png" },
    { "op": "wait_seconds", "value": 1.4 },
    { "op": "assert_state", "path": "weather.polarNight.windVisualPct", "atLeast": 75, "atMost": 100 },
    { "op": "assert_state", "path": "particleEffectNameCounts.PolarWindUp", "atLeast": 1 },
    { "op": "screenshot", "name": "02_wind_established.png" },

    { "op": "set_polar_environment", "temperature": -22, "humidity": 93, "wind": 8, "direction": "NONE", "phase": "DANGER_HOLD" },
    { "op": "wait_seconds", "value": 3.6 },
    { "op": "assert_state", "path": "weather.polarNight.phase", "equals": "DANGER_HOLD" },
    { "op": "assert_state", "path": "weather.polarNight.whiteoutCommitted", "equals": false },
    { "op": "assert_state", "path": "weather.polarNight.temperatureTenths", "atLeast": -244, "atMost": -186 },
    { "op": "assert_state", "path": "weather.polarNight.humidityTenths", "atLeast": 860, "atMost": 985 },
    { "op": "assert_state", "path": "weather.polarNight.windTenths", "atLeast": 5, "atMost": 172 },
    { "op": "assert_state", "path": "weather.polarNight.temperatureDanger", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.humidityDanger", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.windDanger", "equals": false },
    { "op": "assert_state", "path": "weather.polarNight.gaugeFluctuationRemainingMs", "atLeast": 1 },
    { "op": "screenshot", "name": "03_two_red_bounded_fluctuation.png" },
    { "op": "save_level_snapshot", "name": "polar_two_red_fluctuation" },
    { "op": "reload_level_snapshot", "name": "polar_two_red_fluctuation" },
    { "op": "assert_state", "path": "weather.polarNight.phase", "equals": "DANGER_HOLD" },
    { "op": "assert_state", "path": "weather.polarNight.temperatureDanger", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.humidityDanger", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.windDanger", "equals": false },
    { "op": "assert_state", "path": "weather.polarNight.gaugeFluctuationRemainingMs", "atLeast": 1 },

    { "op": "set_polar_environment", "temperature": -22, "humidity": 96, "wind": 21, "direction": "DOWN", "phase": "SNOW_BLIND", "remaining": 6.0 },
    { "op": "wait_seconds", "value": 3.6 },
    { "op": "assert_state", "path": "weather.polarNight.phase", "equals": "SNOW_BLIND" },
    { "op": "assert_state", "path": "weather.polarNight.temperatureTenths", "atLeast": -244, "atMost": -186 },
    { "op": "assert_state", "path": "weather.polarNight.humidityTenths", "atLeast": 860, "atMost": 985 },
    { "op": "assert_state", "path": "weather.polarNight.windTenths", "atLeast": 188, "atMost": 285 },
    { "op": "assert_state", "path": "weather.polarNight.temperatureDanger", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.humidityDanger", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.windDanger", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.gaugeFluctuationRemainingMs", "atLeast": 1 },
    { "op": "screenshot", "name": "04_whiteout_bounded_fluctuation.png" },

    { "op": "set_polar_environment", "temperature": -22, "humidity": 96, "wind": 21, "direction": "DOWN", "phase": "SNOW_BLIND", "remaining": 0.5 },
    { "op": "wait_seconds", "value": 0.7 },
    { "op": "assert_state", "path": "weather.polarNight.phase", "equals": "FADE" },
    { "op": "assert_state", "path": "weather.polarNight.temperatureTenths", "atMost": -186 },
    { "op": "assert_state", "path": "weather.polarNight.humidityTenths", "atLeast": 860 },
    { "op": "assert_state", "path": "weather.polarNight.windTenths", "atLeast": 188 },
    { "op": "screenshot", "name": "05_whiteout_recovery_early.png" },
    { "op": "save_level_snapshot", "name": "polar_whiteout_recovery" },
    { "op": "reload_level_snapshot", "name": "polar_whiteout_recovery" },
    { "op": "assert_state", "path": "weather.polarNight.phase", "equals": "FADE" },
    { "op": "wait_seconds", "value": 1.8 },
    { "op": "assert_state", "path": "weather.polarNight.phase", "equals": "FADE" },
    { "op": "assert_state", "path": "weather.polarNight.temperatureTenths", "atMost": -160 },
    { "op": "assert_state", "path": "weather.polarNight.humidityTenths", "atLeast": 650 },
    { "op": "assert_state", "path": "weather.polarNight.windTenths", "atLeast": 100 },
    { "op": "screenshot", "name": "06_whiteout_recovery_mid.png" },
    { "op": "dump_state", "name": "polar_night_dynamics_final.json" }
  ]
}
