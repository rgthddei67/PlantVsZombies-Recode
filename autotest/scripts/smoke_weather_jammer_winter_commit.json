{
  "commands": [
    { "op": "goto_level", "level": 60 },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"], "timeout": 20 },
    { "op": "wait_state", "state": "GAME", "timeout": 20 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_weather_forecast", "forecast": "HEAVY", "actual": "MEDIUM", "revealIn": 12.0 },
    { "op": "set_cold_wave", "phase": "CALM", "strength": "STRONG", "temperature": 6.0, "remaining": 12.0, "targetTemperature": -12.0 },
    { "op": "spawn_zombie", "type": "ZOMBIE_WEATHER_JAMMER", "row": 2, "x": 900.0, "stationary": true },
    { "op": "wait_seconds", "value": 0.25 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerPhase", "equals": "CHANNELING" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.isEating", "equals": false },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.helmHealth", "equals": 1100 },
    { "op": "assert_state", "path": "weatherJammerResources.packReanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "weatherJammerResources.terminalReanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "weatherJammerResources.packTexturesLoaded", "equals": true },
    { "op": "assert_state", "path": "weatherJammerResources.terminalTexturesLoaded", "equals": true },
    { "op": "wait_seconds", "value": 4.2 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerPhase", "equals": "SPENT" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerCommittedDisruptionMask", "equals": 3 },
    { "op": "assert_state", "path": "weather.forecastDisrupted", "equals": true },
    { "op": "assert_state", "path": "weather.forecastIntensity", "equals": "HEAVY" },
    { "op": "assert_state", "path": "weather.lockedActualIntensity", "equals": "MEDIUM" },
    { "op": "assert_state", "path": "weather.forecastDisplayText", "equals": "天气预报：气象信号受干扰" },
    { "op": "assert_state", "path": "weather.winter.coldWaveForecastDisrupted", "equals": true },
    { "op": "assert_state", "path": "weather.winter.coldWaveDisruptionVisible", "equals": true },
    { "op": "assert_state", "path": "weather.winter.coldWaveDisplayText", "equals": "寒潮预报：气象信号受干扰" },
    { "op": "screenshot", "name": "weather_jammer_winter_commit.png" },
    { "op": "save_level_snapshot", "name": "weather_jammer_winter_committed" },
    { "op": "reload_level_snapshot", "name": "weather_jammer_winter_committed" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerPhase", "equals": "SPENT" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerCommittedDisruptionMask", "equals": 3 },
    { "op": "assert_state", "path": "weather.forecastDisrupted", "equals": true },
    { "op": "assert_state", "path": "weather.lockedActualIntensity", "equals": "MEDIUM" },
    { "op": "assert_state", "path": "weather.winter.coldWaveDisruptionVisible", "equals": true },
    { "op": "dump_state", "name": "state.json" },
    { "op": "quit" }
  ]
}
