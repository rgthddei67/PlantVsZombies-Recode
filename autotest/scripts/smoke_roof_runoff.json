{
  "commands": [
    { "op": "goto_level", "level": 37 },
    { "op": "assert_state", "path": "background", "equals": "ROOF" },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "wait_seconds", "value": 0.5 },
    { "op": "assert_state", "path": "weather.panelSlidePct", "equals": 100 },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": true },
    { "op": "assert_state", "path": "weather.roofRunoff.phase", "equals": "IDLE" },

    { "op": "set_weather", "intensity": "LIGHT", "duration": 90 },
	{ "op": "set_roof_runoff", "phase": "IDLE", "charge": 100 },
	{ "op": "wait_frames", "value": 2 },
	{ "op": "assert_state", "path": "weather.roofRunoff.phase", "equals": "WARNING" },
	{ "op": "assert_state", "path": "weather.roofRunoff.rowCount", "atLeast": 1, "atMost": 3 },
	{ "op": "assert_state", "path": "weather.roofRunoff.retainedChargePct", "atLeast": 30, "atMost": 60 },
    { "op": "set_roof_runoff", "phase": "IDLE", "charge": 20 },
    { "op": "wait_seconds", "value": 2.0 },
	{ "op": "assert_state", "path": "weather.roofRunoff.chargePct", "equals": 22 },

    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 1, "col": 1 },
    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 2, "col": 1 },
	{ "op": "plant", "type": "PLANT_PEASHOOTER", "row": 3, "col": 1 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 1, "x": 560, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 2, "x": 560, "stationary": true },
	{ "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 3, "x": 560, "stationary": true },

	{ "op": "set_roof_runoff", "phase": "WARNING", "charge": 100, "rows": [1, 3], "remaining": 2.5, "retainedCharge": 45 },
    { "op": "assert_state", "path": "weather.roofRunoff.phase", "equals": "WARNING" },
	{ "op": "assert_state", "path": "weather.roofRunoff.rowCount", "equals": 2 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rows.0", "equals": 1 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rows.1", "equals": 3 },
    { "op": "assert_state", "path": "topPlantsByCell.1_1.roofRunoffPaused", "equals": false },
    { "op": "wait_seconds", "value": 0.4 },
    { "op": "screenshot", "name": "01_roof_runoff_warning.png" },

	{ "op": "set_roof_runoff", "phase": "FLOWING", "charge": 100, "rows": [1, 3], "remaining": 1.4, "retainedCharge": 45 },
	{ "op": "assert_state", "path": "weather.roofRunoff.zombieDriftSpeed", "equals": -60 },
    { "op": "assert_state", "path": "topPlantsByCell.1_1.roofRunoffPaused", "equals": true },
    { "op": "assert_state", "path": "topPlantsByCell.2_1.roofRunoffPaused", "equals": false },
	{ "op": "assert_state", "path": "topPlantsByCell.3_1.roofRunoffPaused", "equals": true },
    { "op": "save_level_snapshot", "name": "roof_runoff_active" },
    { "op": "reload_level_snapshot", "name": "roof_runoff_active" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "weather.roofRunoff.phase", "equals": "FLOWING" },
	{ "op": "assert_state", "path": "weather.roofRunoff.rowCount", "equals": 2 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rows.0", "equals": 1 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rows.1", "equals": 3 },
	{ "op": "assert_state", "path": "weather.roofRunoff.retainedChargePct", "equals": 45 },
    { "op": "assert_state", "path": "topPlantsByCell.1_1.roofRunoffPaused", "equals": true },
	{ "op": "assert_state", "path": "topPlantsByCell.3_1.roofRunoffPaused", "equals": true },
    { "op": "wait_seconds", "value": 0.5 },
	{ "op": "assert_state", "path": "zombies.0.x", "atMost": 535 },
    { "op": "assert_state", "path": "zombies.1.x", "atLeast": 559, "atMost": 561 },
	{ "op": "assert_state", "path": "zombies.2.x", "atMost": 535 },
    { "op": "screenshot", "name": "02_roof_runoff_flowing.png" },

    { "op": "wait_seconds", "value": 1.0 },
    { "op": "assert_state", "path": "weather.roofRunoff.phase", "equals": "IDLE" },
	{ "op": "assert_state", "path": "weather.roofRunoff.chargePct", "atLeast": 45, "atMost": 46 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rowMask", "equals": 0 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rowCount", "equals": 0 },
	{ "op": "assert_state", "path": "weather.roofRunoff.retainedChargePct", "equals": 0 },
    { "op": "assert_state", "path": "topPlantsByCell.1_1.roofRunoffPaused", "equals": false },

    { "op": "goto_level", "level": 45 },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_ROOF" },
	{ "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
	{ "op": "wait_state", "state": "GAME", "timeout": 15 },
	{ "op": "set_spawn_paused", "value": true },
	{ "op": "set_weather", "intensity": "LIGHT", "duration": 90 },
	{ "op": "set_roof_runoff", "phase": "FLOWING", "charge": 100, "rows": [0, 4], "remaining": 1.2, "retainedCharge": 52 },
	{ "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": true },
	{ "op": "assert_state", "path": "weather.roofRunoff.phase", "equals": "FLOWING" },
	{ "op": "assert_state", "path": "weather.roofRunoff.rowCount", "equals": 2 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rows.0", "equals": 0 },
	{ "op": "assert_state", "path": "weather.roofRunoff.rows.1", "equals": 4 },
	{ "op": "wait_seconds", "value": 0.3 },
	{ "op": "screenshot", "name": "03_night_roof_runoff_flowing.png" },
    { "op": "dump_state", "name": "roof_runoff_state.json" },
    { "op": "quit" }
  ]
}
