{
  "commands": [
    { "op": "goto_level", "level": 26 },
    { "op": "assert_state", "path": "levelName", "equals": "关卡 3-8" },
    { "op": "assert_state", "path": "background", "equals": "WATER_POOL" },
    { "op": "assert_state", "path": "maxWave", "equals": 20 },
    { "op": "assert_state", "path": "spawnList", "equals": ["ZOMBIE_NORMAL", "ZOMBIE_TRAFFIC_CONE", "ZOMBIE_BUCKET", "ZOMBIE_DOLPHIN_RIDER", "ZOMBIE_ELITE_DOLPHIN_RIDER"] },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_DOLPHIN_RIDER", "row": 0, "expected": false },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_DOLPHIN_RIDER", "row": 2, "expected": true },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_DOLPHIN_RIDER", "row": 3, "expected": true },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_DOLPHIN_RIDER", "row": 5, "expected": false },
    { "op": "choose_cards", "cards": ["PLANT_LILYPAD", "PLANT_WALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },

    { "op": "plant", "type": "PLANT_LILYPAD", "row": 2, "col": 5 },
    { "op": "plant", "type": "PLANT_WALLNUT", "row": 2, "col": 5 },
    { "op": "plant", "type": "PLANT_LILYPAD", "row": 2, "col": 1 },
    { "op": "plant", "type": "PLANT_WALLNUT", "row": 2, "col": 1 },
    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_DOLPHIN_RIDER", "row": 2, "x": 1040 },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 700 },
    { "op": "assert_state", "path": "zombies.0.dolphinJumpCapacity", "equals": 2 },
    { "op": "assert_state", "path": "zombies.0.successfulDolphinJumps", "equals": 0 },
    { "op": "wait_seconds", "value": 2.8, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "ENTERING_POOL" },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_jumpinpool" },
    { "op": "assert_state", "path": "zombies.0.inPool", "equals": false },
    { "op": "screenshot", "name": "00_throwing_pink_dolphin_from_shore.png" },
    { "op": "wait_seconds", "value": 2.5, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "RIDING" },
    { "op": "screenshot", "name": "01_blue_rider_pink_dolphin.png" },

    { "op": "wait_seconds", "value": 3.0, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "JUMPING" },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_dolphinjump" },
    { "op": "assert_state", "path": "zombies.0.successfulDolphinJumps", "equals": 0 },
    { "op": "save_level_snapshot", "name": "elite_dolphin_first_jump" },
    { "op": "reload_level_snapshot", "name": "elite_dolphin_first_jump" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "JUMPING" },
    { "op": "assert_state", "path": "zombies.0.successfulDolphinJumps", "equals": 0 },
    { "op": "screenshot", "name": "02_first_jump_after_snapshot.png" },

    { "op": "wait_seconds", "value": 0.8, "timeout": 3 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "JUMPING" },
    { "op": "assert_state", "path": "zombies.0.dolphinJumpProgressOn1000", "atLeast": 650, "atMost": 900 },
    { "op": "screenshot", "name": "03_first_jump_before_landing.png" },
    { "op": "wait_seconds", "value": 1.0, "timeout": 3 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "RIDING" },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_ride" },
    { "op": "assert_state", "path": "zombies.0.hasDolphin", "equals": true },
    { "op": "assert_state", "path": "zombies.0.successfulDolphinJumps", "equals": 1 },
    { "op": "screenshot", "name": "03_first_landing_keeps_dolphin.png" },

    { "op": "wait_seconds", "value": 4.6, "timeout": 7 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "JUMPING" },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_dolphinjump" },
    { "op": "assert_state", "path": "zombies.0.successfulDolphinJumps", "equals": 1 },
    { "op": "screenshot", "name": "04_second_jump.png" },
    { "op": "wait_seconds", "value": 1.8, "timeout": 4 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "WALKING_WITHOUT_DOLPHIN" },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_walk" },
    { "op": "assert_state", "path": "zombies.0.inPool", "equals": false },
    { "op": "assert_state", "path": "zombies.0.hasDolphin", "equals": false },
    { "op": "assert_state", "path": "zombies.0.successfulDolphinJumps", "equals": 2 },
    { "op": "screenshot", "name": "05_second_landing_dismounts.png" },

    { "op": "reset_test_state" },
    { "op": "goto_level", "level": 26 },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_DOLPHIN_RIDER", "row": 0, "x": 700, "stationary": true },
    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 470, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "particleEffectNameCounts.EliteDolphinRiderHeadOff", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.EliteDolphinRiderHeadOff.0.renderProbeReady", "equals": true },
    { "op": "screenshot", "name": "06_blue_head_particle.png" },

    { "op": "dump_state", "name": "elite_dolphin_rider_final_state.json" },
    { "op": "quit" }
  ]
}
