{
  "commands": [
    { "op": "goto_level", "level": 37 },
    { "op": "assert_state", "path": "boardState", "equals": "CHOOSE_CARD" },
    { "op": "assert_state", "path": "background", "equals": "ROOF" },
    { "op": "assert_state", "path": "roofResources.rainBackgroundLoaded", "equals": true },
    { "op": "assert_state", "path": "roofResources.roofCleanerReanimationLoaded", "equals": true },
    { "op": "dump_state", "name": "00_roof_preview_probe.json" },
    { "op": "assert_state", "path": "previewZombies.0.terrainYOffsetOn1000", "equals": 0 },
    { "op": "assert_state", "path": "previewZombies.0.xInt", "atLeast": 1056, "atMost": 1356 },
    { "op": "assert_state", "path": "previewZombies.0.row", "atLeast": 1, "atMost": 4 },
    { "op": "wait_seconds", "value": 4.2 },
    { "op": "screenshot", "name": "01_roof_preview.png" },

    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER", "PLANT_JALAPENO"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "assert_state", "path": "mowerCount", "equals": 5 },
    { "op": "assert_state", "path": "mowers.0.type", "equals": "ROOF" },
    { "op": "assert_state", "path": "mowers.0.terrainYOffsetOn1000", "equals": 0 },
    { "op": "assert_state", "path": "mowers.0.shadowOffsetXInt", "equals": 41 },
    { "op": "assert_state", "path": "mowers.0.shadowOffsetYInt", "equals": 22 },
    { "op": "screenshot", "name": "01b_roof_cleaners_idle.png" },

    { "op": "add_crater", "row": 0, "col": 2, "timeLeft": 180 },
    { "op": "add_crater", "row": 0, "col": 6, "timeLeft": 80 },
    { "op": "assert_state", "path": "craters.0.textureKey", "equals": "IMAGE_CRATER_ROOF_LEFT_PART_0" },
    { "op": "assert_state", "path": "craters.0.textureLoaded", "equals": true },
    { "op": "assert_state", "path": "craters.1.textureKey", "equals": "IMAGE_CRATER_ROOF_CENTER_PART_1" },
    { "op": "assert_state", "path": "craters.1.textureLoaded", "equals": true },

    { "op": "extend_ice_trail", "row": 3, "frontX": 300 },
    { "op": "assert_state", "path": "iceTrails.3.active", "equals": true },
    { "op": "assert_state", "path": "iceTrails.3.minXInt", "equals": 642 },
    { "op": "assert_state", "path": "iceTrails.3.leftTopYInt", "equals": 353 },
    { "op": "assert_state", "path": "iceTrails.3.slopeEndTopYInt", "equals": 353 },

    { "op": "spawn_bullet", "type": "BULLET_PEA", "row": 2, "x": 300, "y": 360, "velocityX": 200 },
    { "op": "assert_state", "path": "bulletCount", "equals": 1 },
    { "op": "wait_seconds", "value": 0.5 },
    { "op": "assert_state", "path": "bulletCount", "equals": 0 },

    { "op": "plant", "type": "PLANT_FLOWERPOT", "row": 4, "col": 6 },
    { "op": "plant", "type": "PLANT_JALAPENO", "row": 4, "col": 6 },
    { "op": "wait_seconds", "value": 1.1 },
    { "op": "assert_state", "path": "jalapenoFireCount", "equals": 12 },
    { "op": "assert_state", "path": "jalapenoFirePath.0.yInt", "equals": 506 },
    { "op": "assert_state", "path": "jalapenoFirePath.11.yInt", "equals": 408 },
    { "op": "screenshot", "name": "02_roof_ice_fire_craters.png" },
    { "op": "wait_seconds", "value": 1.5 },

    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 1, "col": 1 },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 255 },
    { "op": "set_typhoon", "strength": "SEVERE", "direction": "FRONT", "gustIn": 30, "directionIn": 30, "gustsRemaining": 1, "decayIn": 30 },
    { "op": "trigger_typhoon_gust", "plantMoveIn": 0.0 },
    { "op": "wait_seconds", "value": 0.1 },
    { "op": "assert_state", "path": "cells.1.2.under", "equals": "PLANT_FLOWERPOT" },
    { "op": "assert_state", "path": "cells.1.2.normal", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "topPlantsByCell.1_2.terrainXOffsetOn1000", "equals": 0 },
    { "op": "assert_state", "path": "topPlantsByCell.1_2.terrainYOffsetOn1000", "equals": 0 },
    { "op": "assert_state", "path": "topPlantsByCell.1_2.roofVisualPathErrorOn1000", "equals": -20000 },
    { "op": "screenshot", "name": "03_roof_typhoon_plant_slide.png" },
    { "op": "wait_seconds", "value": 0.4 },
    { "op": "assert_state", "path": "topPlantsByCell.1_2.visualOffsetXOn1000", "equals": 0 },
    { "op": "assert_state", "path": "topPlantsByCell.1_2.visualOffsetYOn1000", "equals": -5000 },

    { "op": "trigger_rain_ground_splash" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "particleEffectsByName.RainGroundSplash.0.roofTerrainInsideRow", "equals": true },

    { "op": "trigger_mower", "row": 0 },
    { "op": "wait_seconds", "value": 0.5 },
    { "op": "assert_state", "path": "mowers.0.state", "equals": "MOVING" },
    { "op": "assert_state", "path": "mowers.0.animationPlaying", "equals": true },
    { "op": "assert_state", "path": "mowers.0.terrainYOffsetOn1000", "equals": 0 },
    { "op": "assert_state", "path": "mowers.0.shadowOffsetXInt", "equals": 31 },
    { "op": "assert_state", "path": "mowers.0.shadowOffsetYInt", "equals": 58 },
    { "op": "screenshot", "name": "04_roof_cleaner_moving.png" },

    { "op": "save_level_snapshot", "name": "roof_terrain_consumers" },
    { "op": "reload_level_snapshot", "name": "roof_terrain_consumers" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "mowers.0.type", "equals": "ROOF" },
    { "op": "assert_state", "path": "mowers.0.state", "equals": "MOVING" },
    { "op": "assert_state", "path": "mowers.0.animationPlaying", "equals": true },
    { "op": "assert_state", "path": "mowers.0.terrainYOffsetOn1000", "equals": 0 },
    { "op": "assert_state", "path": "mowers.0.shadowOffsetXInt", "equals": 31 },
    { "op": "assert_state", "path": "mowers.0.shadowOffsetYInt", "equals": 58 },
    { "op": "assert_state", "path": "topPlantsByCell.1_2.terrainYOffsetOn1000", "equals": 0 },
    { "op": "dump_state", "name": "roof_terrain_consumers_state.json" },

    { "op": "goto_level", "level": 45 },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_ROOF" },
    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 0 },
    { "op": "assert_state", "path": "previewZombies.0.terrainYOffsetOn1000", "equals": 0 },
    { "op": "wait_seconds", "value": 4.2 },
    { "op": "screenshot", "name": "05_night_roof_consumers.png" },
    { "op": "quit" }
  ]
}
