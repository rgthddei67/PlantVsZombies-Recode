{
  "commands": [
    { "op": "goto_level", "level": 61, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_KERNELPULT", "PLANT_COBCANNON"], "timeout": 20 },
    { "op": "wait_state", "state": "GAME", "timeout": 20 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_monte_carlo_ai", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_KERNELPULT", "row": 2, "col": 7 },
    { "op": "plant", "type": "PLANT_KERNELPULT", "row": 2, "col": 8 },
    { "op": "plant", "type": "PLANT_COBCANNON", "row": 2, "col": 8 },
    { "op": "set_cold_wave", "phase": "COLD", "temperature": 0, "remaining": 30, "strength": "WEAK", "targetTemperature": 0 },
    { "op": "wait_frames", "value": 2 },

    { "op": "assert_state", "path": "weather.winter.frozenColumns", "equals": 1 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_COBCANNON.simulationPersistent", "equals": true },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_COBCANNON.simulationFuturePlantable", "equals": false },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_COBCANNON.simulationCobBlastCooldownMs", "equals": 34830 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_COBCANNON.simulationCobBlastDamage", "equals": 1800 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_COBCANNON.simulationCobBlastRadius", "equals": 115 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_COBCANNON.simulationCobBlastRowRadius", "equals": 1 },

    { "op": "spawn_zombie", "type": "ZOMBIE_ICE_STATUE_EXECUTIONER", "row": 2, "x": 820, "stationary": true },
    { "op": "wait_seconds", "value": 0.2 },
    { "op": "dump_state", "name": "ice_executioner_cob_targeting_probe.json" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionPhase", "equals": "EXECUTING" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionTargetingMode", "equals": "MONTE_CARLO" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionMonteCarloRollouts", "equals": 48 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionMonteCarloCandidates", "equals": 1 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionRequiredStrikes", "equals": 7 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.iceSealed", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.iceSealed", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.id", "equals": 3 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.id", "equals": 3 },
    { "op": "screenshot", "name": "01_cob_one_wheel_frozen_execution.png" },

    { "op": "set_ice_executioner_state", "row": 2, "targetRow": 2, "targetCol": 7, "progress": 5 },
    { "op": "wait_seconds", "value": 2.6 },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.health", "equals": 260 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionProgress", "equals": 6 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionRequiredStrikes", "equals": 7 },
    { "op": "save_level_snapshot", "name": "ice_executioner_cob_after_sixth_strike" },
    { "op": "reload_level_snapshot", "name": "ice_executioner_cob_after_sixth_strike" },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.iceSealed", "equals": true },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionProgress", "equals": 6 },
    { "op": "wait_seconds", "value": 2.6 },
    { "op": "assert_state", "path": "plantCount", "equals": 0 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionPhase", "equals": "SPENT" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_STATUE_EXECUTIONER.executionUsed", "equals": true },
    { "op": "dump_state", "name": "ice_executioner_cob_monte_carlo_final.json" },
    { "op": "quit" }
  ]
}
