{
  "name": "smoke_survival_endless_terrains",
  "commands": [
    { "op": "wait_frames", "value": 60 },
    { "op": "click", "x": 680, "y": 350 },
    { "op": "wait_frames", "value": 60 },
    { "op": "assert_state", "path": "gameSelectMode", "equals": "SURVIVAL" },
    { "op": "assert_state", "path": "gameSelectAvailableLevels", "equals": [1000, 1001, 1002, 1003, 1004, 1005, 1006] },
    { "op": "assert_state", "path": "gameSelectVisibleCompleted", "equals": [false, false, false, false, false, false, false] },
    { "op": "screenshot", "name": "01_seven_endless_terrains.png" },

    { "op": "click", "x": 621, "y": 182 },
    { "op": "wait_frames", "value": 150 },
    { "op": "assert_state", "path": "level", "equals": 1003 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：黑夜泳池无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_WATER_POOL" },
    { "op": "assert_state", "path": "rows", "equals": 6 },
    { "op": "assert_state", "path": "poolRows", "equals": [2, 3] },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "fog.supported", "equals": true },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": false },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": false },
    { "op": "screenshot", "name": "02_night_pool_endless.png" },

    { "op": "goto_level", "level": 1004, "resetTestState": true },
    { "op": "wait_frames", "value": 120 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：白天屋顶无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "ROOF" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "poolRows", "equals": [] },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": false },
    { "op": "screenshot", "name": "03_day_roof_endless.png" },

    { "op": "goto_level", "level": 1005, "resetTestState": true },
    { "op": "wait_frames", "value": 120 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：黑夜屋顶无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_ROOF" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": true },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": false },
    { "op": "screenshot", "name": "04_night_roof_endless.png" },

    { "op": "goto_level", "level": 1006, "resetTestState": true },
    { "op": "wait_frames", "value": 120 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：雪原无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "WINTER_GARDEN" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "poolRows", "equals": [] },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "fog.supported", "equals": false },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": false },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": true },
    { "op": "screenshot", "name": "05_winter_endless.png" },
    { "op": "quit" }
  ]
}
