{
  "name": "smoke_survival_endless_terrains",
  "commands": [
    { "op": "wait_frames", "value": 60 },
    { "op": "set_adventure_level", "level": 73 },
    { "op": "click", "target": "main_menu_survival" },
    { "op": "wait_frames", "value": 60 },
    { "op": "assert_state", "path": "gameSelectMode", "equals": "SURVIVAL" },
    { "op": "assert_state", "path": "gameSelectAvailableLevels", "equals": [1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007] },
    { "op": "assert_state", "path": "gameSelectVisibleCompleted", "equals": [false, false, false, false, false, false, false, false] },
    { "op": "screenshot", "name": "01_eight_endless_terrains.png" },

    { "op": "click", "x": 621, "y": 182 },
    { "op": "wait_frames", "value": 150 },
    { "op": "assert_state", "path": "level", "equals": 1003 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：黑夜泳池无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_WATER_POOL" },
    { "op": "assert_state", "path": "rows", "equals": 6 },
    { "op": "assert_state", "path": "poolRows", "equals": [2, 3] },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "fog.supported", "equals": true },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": false },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": false },
    { "op": "screenshot", "name": "02_night_pool_endless.png" },

    { "op": "goto_level", "level": 1004, "resetTestState": true },
    { "op": "wait_frames", "value": 120 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：白天屋顶无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "ROOF" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "poolRows", "equals": [] },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": false },
    { "op": "screenshot", "name": "03_day_roof_endless.png" },

    { "op": "goto_level", "level": 1005, "resetTestState": true },
    { "op": "wait_frames", "value": 120 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：黑夜屋顶无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_ROOF" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": true },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": true },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": false },
    { "op": "screenshot", "name": "04_night_roof_endless.png" },

    { "op": "goto_level", "level": 1006, "resetTestState": true },
    { "op": "wait_frames", "value": 120 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：雪原无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "WINTER_GARDEN" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "poolRows", "equals": [] },
    { "op": "assert_state", "path": "supportsWeather", "equals": true },
    { "op": "assert_state", "path": "fog.supported", "equals": false },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": false },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": true },
    { "op": "screenshot", "name": "05_winter_endless.png" },

    { "op": "goto_level", "level": 1007, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "assert_state", "path": "level", "equals": 1007 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：极夜无尽 第1轮" },
    { "op": "assert_state", "path": "background", "equals": "POLAR_NIGHT_SNOWFIELD" },
    { "op": "assert_state", "path": "rows", "equals": 5 },
    { "op": "assert_state", "path": "poolRows", "equals": [] },
    { "op": "assert_state", "path": "supportsWeather", "equals": false },
    { "op": "assert_state", "path": "fog.supported", "equals": false },
    { "op": "assert_state", "path": "weather.roofRunoff.supported", "equals": false },
    { "op": "assert_state", "path": "weather.nightRoofCharge.supported", "equals": false },
    { "op": "assert_state", "path": "weather.winter.supported", "equals": false },
    { "op": "assert_state", "path": "weather.polarNight.supported", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.initialized", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.finalWaveUpgradeApplied", "equals": false },
    { "op": "assert_state", "path": "survivalRound", "equals": 1 },
    { "op": "screenshot", "name": "06_polar_endless.png" },

    { "op": "force_survival_round", "round": 22 },
    { "op": "assert_state", "path": "levelName", "equals": "生存模式：极夜无尽 第22轮" },
    { "op": "assert_state", "path": "survivalPoolSnowBurrowEligible", "equals": true },
    { "op": "assert_state", "path": "survivalPoolAdaptiveHelmetEligible", "equals": true },
    { "op": "assert_state", "path": "survivalPoolThermalSniperEligible", "equals": true },
    { "op": "assert_state", "path": "survivalPoolAuroraPriestEligible", "equals": true },
    { "op": "assert_state", "path": "survivalPoolPolarClockmakerEligible", "equals": true },
    { "op": "save_level_snapshot", "name": "polar_endless_round_22" },
    { "op": "force_survival_round", "round": 1 },
    { "op": "reload_level_snapshot", "name": "polar_endless_round_22" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "level", "equals": 1007 },
    { "op": "assert_state", "path": "survivalRound", "equals": 22 },
    { "op": "assert_state", "path": "background", "equals": "POLAR_NIGHT_SNOWFIELD" },
    { "op": "assert_state", "path": "weather.polarNight.supported", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.initialized", "equals": true },
    { "op": "assert_state", "path": "weather.polarNight.finalWaveUpgradeApplied", "equals": false },
    { "op": "screenshot", "name": "07_polar_endless_round_22_reloaded.png" },
    { "op": "quit" }
  ]
}
