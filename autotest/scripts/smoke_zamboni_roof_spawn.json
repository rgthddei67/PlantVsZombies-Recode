    { "op": "assert_state", "path": "zombies.0.row", "equals": 4 },
    { "op": "assert_state", "path": "zombies.0.terrainYOffsetOn1000", "equals": 0 },
    { "op": "assert_state", "path": "zombies.0.zamboniDriveCoordinateBaseXInt", "equals": 242 },
