{
  "commands": [
    { "op": "goto_level", "level": 10 },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER", "PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 5 },
    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 0, "col": 4 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 0, "x": 620 },
    { "op": "wait_seconds", "value": 0.4, "timeout": 3 },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": 2 },
    { "op": "assert_state", "path": "topPlantsByCell.0_4.eaterCount", "equals": 1 },

    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "set_typhoon", "strength": "SUPER", "direction": "FRONT", "gustIn": 30, "directionIn": 30, "gustsRemaining": 2, "decayIn": 60 },
    { "op": "trigger_typhoon_gust" },
    { "op": "wait_seconds", "value": 2.5, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": false },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": -1024 },
    { "op": "assert_state", "path": "topPlantsByCell.0_4.eaterCount", "equals": 0 },
    { "op": "screenshot", "name": "01_gust_releases_old_plant_target.png" },

    { "op": "damage_plant", "row": 0, "col": 4, "damage": 300, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "plantCount", "equals": 1 },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": false },

    { "op": "goto_level", "level": 25, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_LILYPAD", "PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_LILYPAD", "row": 2, "col": 5 },
    { "op": "plant", "type": "PLANT_TALLNUT", "row": 2, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_DOLPHIN_RIDER", "row": 2, "x": 1040 },
    { "op": "wait_seconds", "value": 5.3, "timeout": 8 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "RIDING" },
    { "op": "wait_seconds", "value": 3.0, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.dolphinPhase", "equals": "SWIMMING" },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": 2 },
    { "op": "assert_state", "path": "topPlantsByCell.2_5.eaterCount", "equals": 1 },
    { "op": "save_level_snapshot", "name": "blocked_dolphin_eating" },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "set_typhoon", "strength": "SUPER", "direction": "FRONT", "gustIn": 30, "directionIn": 30, "gustsRemaining": 2, "decayIn": 60 },
    { "op": "trigger_typhoon_gust" },
    { "op": "wait_seconds", "value": 2.5, "timeout": 5 },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": false },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": -1024 },
    { "op": "assert_state", "path": "topPlantsByCell.2_5.eaterCount", "equals": 0 },
    { "op": "screenshot", "name": "02_blocked_dolphin_releases_old_tallnut_target.png" },

    { "op": "reload_level_snapshot", "name": "blocked_dolphin_eating" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": 2 },
    { "op": "damage_plant", "row": 2, "col": 5, "index": 1, "damage": 9000, "source": "OTHER" },
    { "op": "damage_plant", "row": 2, "col": 5, "index": 0, "damage": 9000, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "plantCount", "equals": 0 },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": false },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": -1024 },

    { "op": "reload_level_snapshot", "name": "blocked_dolphin_eating" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": 2 },
    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 500, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.isDying", "equals": true },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": false },
    { "op": "assert_state", "path": "zombies.0.eatPlantID", "equals": -1024 },
    { "op": "assert_state", "path": "topPlantsByCell.2_5.eaterCount", "equals": 0 },
    { "op": "screenshot", "name": "03_dying_dolphin_stops_eating.png" },
    { "op": "dump_state", "name": "state.json" },
    { "op": "quit" }
  ]
}
