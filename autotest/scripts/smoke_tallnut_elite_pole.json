{
  "commands": [
    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": ["PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },

    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_POLEVAULTER", "row": 0, "x": 760 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombieCount", "equals": 1 },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_ELITE_POLEVAULTER" },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 450 },
    { "op": "assert_state", "path": "zombies.0.vaultState", "equals": "JUMPING" },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_jump" },
    { "op": "assert_state", "path": "zombies.0.vaultBlockChecked", "equals": false },
    { "op": "assert_state", "path": "zombies.0.vaultHasTarget", "equals": true },
    { "op": "assert_state", "path": "zombies.0.vaultProgressOn1000", "atMost": 590 },
    { "op": "assert_state", "path": "plants.0.health", "equals": 9000 },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "equals": 0 },
    { "op": "screenshot", "name": "01_elite_pole_jump_before_block.png" },

    { "op": "wait_seconds", "value": 1.0, "timeout": 3 },
    { "op": "assert_state", "path": "zombieCount", "equals": 2 },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_ELITE_POLEVAULTER" },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 450 },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_eat" },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "zombies.0.vaultState", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.hasVaulted", "equals": true },
    { "op": "assert_state", "path": "zombies.0.vaultBlockChecked", "equals": true },
    { "op": "assert_state", "path": "zombies.0.vaultHasTarget", "equals": false },
    { "op": "assert_state", "path": "zombies.0.lastVaultDistanceOn1000", "equals": 0 },
    { "op": "assert_state", "path": "zombies.0.vaultExtraDistanceAppliedOn1000", "equals": 0 },
    { "op": "assert_state", "path": "zombies.1.type", "equals": "ZOMBIE_POLEVAULTER" },
    { "op": "assert_state", "path": "plants.0.health", "equals": 8500 },
    { "op": "assert_state", "path": "plants.0.eaterCount", "equals": 1 },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "equals": 1 },
    { "op": "screenshot", "name": "02_elite_pole_blocked_and_summoned.png" },
    { "op": "assert_state", "path": "particleEffectNameCounts.TallNutBlock", "equals": 1 },
    { "op": "dump_state", "name": "tallnut_elite_pole_state.json" },
    { "op": "quit" }
  ]
}
