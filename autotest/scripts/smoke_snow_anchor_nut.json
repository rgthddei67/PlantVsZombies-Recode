    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },

    { "op": "assert_state", "path": "background", "equals": "WINTER_GARDEN" },
    { "op": "assert_state", "path": "snowAnchorNutResources.reanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "snowAnchorNutResources.cardTextureLoaded", "equals": true },
    { "op": "assert_state", "path": "snowAnchorNutResources.bodyTexturesLoaded", "equals": true },
    { "op": "assert_state", "path": "snowAnchorNutResources.bracedTexturesLoaded", "equals": true },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_SNOWANCHORNUT.sunCost", "equals": 100 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_SNOWANCHORNUT.cooldownMs", "equals": 30000 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_SNOWANCHORNUT.simulationBaseHealth", "equals": 3000 },

    { "op": "set_cold_wave", "phase": "CALM", "temperature": 6, "remaining": 30 },
    { "op": "plant", "type": "PLANT_SNOWANCHORNUT", "row": 2, "col": 8 },
    { "op": "plant", "type": "PLANT_SNOWANCHORNUT", "row": 2, "col": 7 },
    { "op": "plant", "type": "PLANT_SNOWANCHORNUT", "row": 2, "col": 6 },
    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 4, "col": 4 },
    { "op": "wait_seconds", "value": 0.6, "timeout": 3 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.health", "equals": 3000 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.maxHealth", "equals": 3000 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.winterGroundAnchorReady", "equals": false },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.winterGroundAnchorSpent", "equals": false },
    { "op": "resolve_winter_ground_impact", "row": 4, "col": 4, "kind": "COLLISION", "expectedIntercepted": false, "expectedContainsScatter": false, "expectedDownstreamMultiplierOn1000": 1000 },
    { "op": "screenshot", "name": "01_snow_anchor_warm.png" },

    { "op": "set_cold_wave", "phase": "COLD", "temperature": -4, "remaining": 30, "strength": "WEAK", "targetTemperature": -4, "coolingDuration": 23, "holdDuration": 42, "thawDuration": 27 },
    { "op": "wait_seconds", "value": 0.6, "timeout": 3 },
    { "op": "assert_state", "path": "weather.winter.frozenColumns", "equals": 3 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.winterGroundAnchorReady", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.winterGroundAnchorReady", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorReady", "equals": true },
    { "op": "assert_can_plant", "type": "PLANT_SNOWANCHORNUT", "row": 1, "col": 8, "expected": false },
    { "op": "screenshot", "name": "02_snow_anchor_braced.png" },

    { "op": "resolve_winter_ground_impact", "row": 2, "col": 8, "kind": "COLLISION", "expectedIntercepted": true, "expectedContainsScatter": true, "expectedDownstreamMultiplierOn1000": 1000 },
    { "op": "damage_plant", "row": 2, "col": 8, "damage": 1200, "source": "ZOMBIE" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.health", "equals": 1800 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.winterGroundAnchorReady", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.winterGroundAnchorSpent", "equals": false },
    { "op": "resolve_winter_ground_impact", "row": 2, "col": 8, "kind": "COLLISION", "expectedIntercepted": true, "expectedContainsScatter": true, "expectedDownstreamMultiplierOn1000": 1000 },
    { "op": "damage_plant", "row": 2, "col": 8, "damage": 1200, "source": "ZOMBIE" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.health", "equals": 600 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_8.winterGroundAnchorReady", "equals": true },
    { "op": "resolve_winter_ground_impact", "row": 2, "col": 8, "kind": "COLLISION", "expectedIntercepted": true, "expectedContainsScatter": true, "expectedDownstreamMultiplierOn1000": 1000 },
    { "op": "damage_plant", "row": 2, "col": 8, "damage": 1200, "source": "ZOMBIE" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "plantCount", "equals": 3 },

    { "op": "resolve_winter_ground_impact", "row": 2, "col": 7, "kind": "GROUND_CRACK", "expectedIntercepted": true, "expectedContainsScatter": false, "expectedDownstreamMultiplierOn1000": 333 },
    { "op": "resolve_winter_ground_impact", "row": 2, "col": 7, "kind": "GROUND_CRACK", "expectedIntercepted": true, "expectedContainsScatter": false, "expectedDownstreamMultiplierOn1000": 333 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.winterGroundAnchorSpent", "equals": false },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.winterGroundAnchorReady", "equals": true },

    { "op": "set_plant_health", "row": 2, "col": 6, "value": 1500 },
    { "op": "wait_seconds", "value": 0.6, "timeout": 3 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.nutDamageStage", "equals": 1 },
    { "op": "screenshot", "name": "03_snow_anchor_braced_cracked.png" },

    { "op": "save_level_snapshot", "name": "snow_anchor_frozen" },
    { "op": "reload_level_snapshot", "name": "snow_anchor_frozen" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.winterGroundAnchorSpent", "equals": false },
    { "op": "assert_state", "path": "normalPlantsByCell.2_7.winterGroundAnchorReady", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorSpent", "equals": false },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorReady", "equals": true },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.health", "equals": 1500 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.nutDamageStage", "equals": 1 },

    { "op": "set_cold_wave", "phase": "CALM", "temperature": 6, "remaining": 30 },
    { "op": "wait_seconds", "value": 0.6, "timeout": 3 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorReady", "equals": false },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorSpent", "equals": false },
    { "op": "resolve_winter_ground_impact", "row": 2, "col": 6, "kind": "COLLISION", "expectedIntercepted": false, "expectedContainsScatter": false, "expectedDownstreamMultiplierOn1000": 1000 },
    { "op": "screenshot", "name": "04_snow_anchor_thawed_cracked.png" },

    { "op": "set_cold_wave", "phase": "COLD", "temperature": -4, "remaining": 30, "strength": "WEAK", "targetTemperature": -4, "coolingDuration": 23, "holdDuration": 42, "thawDuration": 27 },
    { "op": "wait_seconds", "value": 0.6, "timeout": 3 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorReady", "equals": true },
    { "op": "resolve_winter_ground_impact", "row": 2, "col": 6, "kind": "COLLISION", "expectedIntercepted": true, "expectedContainsScatter": true, "expectedDownstreamMultiplierOn1000": 1000 },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorSpent", "equals": false },
    { "op": "assert_state", "path": "normalPlantsByCell.2_6.winterGroundAnchorReady", "equals": true },

    { "op": "set_adventure_level", "level": 55 },
    { "op": "goto_level", "level": 55, "resetTestState": true },
    { "op": "choose_cards", "cards": [], "timeout": 20 },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "force_trophy" },
    { "op": "wait_frames", "value": 2 },
    { "op": "screenshot", "name": "05_snow_anchor_reward_7_1.png" },
    { "op": "click", "target": "trophy" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "boardState", "equals": "WIN" },
    { "op": "assert_state", "path": "adventureLevel", "equals": 56 },
    { "op": "assert_state", "path": "haveCardCount", "equals": 2 },
    { "op": "assert_state", "path": "haveCards.0", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "haveCards.1", "equals": "PLANT_SNOWANCHORNUT" },
    { "op": "dump_state", "name": "snow_anchor_nut_final_state.json" },
    { "op": "quit" }
  ]
}
