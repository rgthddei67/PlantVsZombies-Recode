{
  "commands": [
    { "op": "goto_level", "level": 37 },
    { "op": "assert_state", "path": "background", "equals": "ROOF" },
    { "op": "assert_state", "path": "roofResources.rainBackgroundLoaded", "equals": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },

    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 0 },
    { "op": "screenshot", "name": "01_roof_clear_sky.png" },

    { "op": "set_weather", "intensity": "LIGHT", "duration": 90 },
    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 96 },
    { "op": "wait_seconds", "value": 5.2 },
    { "op": "screenshot", "name": "02_roof_light_rain_sky.png" },

    { "op": "set_weather", "intensity": "MEDIUM", "duration": 90 },
    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 149 },
    { "op": "wait_seconds", "value": 5.2 },
    { "op": "screenshot", "name": "03_roof_medium_rain_sky.png" },

    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 255 },
    { "op": "wait_seconds", "value": 5.2 },
    { "op": "dump_state", "name": "roof_rain_sky_state.json" },
    { "op": "screenshot", "name": "04_roof_heavy_rain_sky.png" },

    { "op": "goto_level", "level": 45 },
    { "op": "assert_state", "path": "background", "equals": "NIGHT_ROOF" },
    { "op": "assert_state", "path": "roofResources.nightRainBackgroundLoaded", "equals": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 0 },
    { "op": "screenshot", "name": "05_night_roof_clear_sky.png" },

    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "assert_state", "path": "weather.roofRainBackgroundAlpha", "equals": 255 },
    { "op": "wait_seconds", "value": 5.2 },
    { "op": "dump_state", "name": "night_roof_rain_sky_state.json" },
    { "op": "screenshot", "name": "06_night_roof_heavy_rain_sky.png" },
    { "op": "quit" }
  ]
}
