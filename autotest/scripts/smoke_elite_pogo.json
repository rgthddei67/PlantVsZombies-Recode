{
  "commands": [
    { "op": "goto_level", "level": 25 },
    { "op": "assert_state", "path": "background", "equals": "WATER_POOL" },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_POGO", "row": 0, "expected": true },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_POGO", "row": 2, "expected": false },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_POGO", "row": 3, "expected": false },
    { "op": "assert_zombie_spawn_row", "type": "ZOMBIE_ELITE_POGO", "row": 5, "expected": true },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_TALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "assert_state", "path": "elitePogoResources.reanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "elitePogoResources.brokenArmLoaded", "equals": true },
    { "op": "assert_state", "path": "elitePogoResources.damagedStickLoaded", "equals": true },
    { "op": "assert_state", "path": "elitePogoResources.damagedStick2Loaded", "equals": true },
    { "op": "assert_state", "path": "elitePogoResources.pogoParticleLoaded", "equals": true },

    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_POGO", "row": 0, "x": 700 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.type", "equals": "ZOMBIE_ELITE_POGO" },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 850 },
    { "op": "assert_state", "path": "zombies.0.bodyMaxHealth", "equals": 850 },
    { "op": "assert_state", "path": "zombies.0.animExtraSpeedPct", "equals": 115 },
    { "op": "assert_state", "path": "zombies.0.hasMagneticItem", "equals": false },
    { "op": "assert_state", "path": "zombies.0.elitePogoImpactBufferAvailable", "equals": true },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "BOUNCING" },
    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 5 },
    { "op": "plant", "type": "PLANT_TALLNUT", "row": 0, "col": 4 },
    { "op": "screenshot", "name": "01_elite_pogo_appearance.png" },

    { "op": "set_pogo_bounce_remaining", "row": 0, "value": 0.01 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "HIGH_BOUNCE" },
    { "op": "set_pogo_bounce_remaining", "row": 0, "value": 0.01 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "FORWARD_BOUNCE" },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieElitePogo", "equals": 0 },
    { "op": "wait_seconds", "value": 0.20, "timeout": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "FORWARD_BOUNCE" },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": true },
    { "op": "assert_state", "path": "zombies.0.elitePogoImpactBufferAvailable", "equals": false },
    { "op": "assert_state", "path": "plants.0.health", "equals": 8400 },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieElitePogo", "equals": 0 },
    { "op": "screenshot", "name": "02_first_tallnut_buffered.png" },
    { "op": "save_level_snapshot", "name": "elite_pogo_buffer_spent" },
    { "op": "reload_level_snapshot", "name": "elite_pogo_buffer_spent" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.elitePogoImpactBufferAvailable", "equals": false },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": true },

    { "op": "wait_seconds", "value": 1.0, "timeout": 4 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "HIGH_BOUNCE" },
    { "op": "set_pogo_bounce_remaining", "row": 0, "value": 0.01 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "FORWARD_BOUNCE" },
    { "op": "wait_seconds", "value": 0.20, "timeout": 3 },
    { "op": "assert_state", "path": "zombies.0.pogoPhase", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": false },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "assert_state", "path": "bonkSoundRequestCount", "equals": 2 },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieElitePogo", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.ZombieElitePogo.0.activeParticleCount", "atLeast": 1 },
    { "op": "screenshot", "name": "03_second_tallnut_breaks_pogo.png" },

    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 850, "source": "OTHER" },
    { "op": "wait_seconds", "value": 3.0, "timeout": 6 },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },

    { "op": "goto_level", "level": 10, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_MAGNETSHROOM"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_POGO", "row": 2, "x": 620, "stationary": true },
    { "op": "plant", "type": "PLANT_MAGNETSHROOM", "row": 2, "col": 4 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "plants.0.magnetPhase", "equals": "READY" },
    { "op": "assert_state", "path": "plants.0.magnetItemActive", "equals": false },
    { "op": "assert_state", "path": "zombies.0.hasPogo", "equals": true },
    { "op": "assert_state", "path": "zombies.0.hasMagneticItem", "equals": false },
    { "op": "assert_state", "path": "zombies.0.magneticItemAvailable", "equals": false },
    { "op": "assert_state", "path": "magnetSoundRequestCount", "equals": 0 },
    { "op": "screenshot", "name": "04_carbon_pogo_ignores_magnet.png" },
    { "op": "dump_state", "name": "elite_pogo_final_state.json" },
    { "op": "quit" }
  ]
}
