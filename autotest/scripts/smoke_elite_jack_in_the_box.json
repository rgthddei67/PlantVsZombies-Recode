    { "op": "set_monte_carlo_ai", "value": false },
    { "op": "set_sun", "value": 9000 },

    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_JACK_IN_THE_BOX", "row": 2, "x": 950, "stationary": true },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "eliteJackZombieCount", "equals": 1 },
    { "op": "assert_state", "path": "jackZombieCount", "equals": 0 },
    { "op": "assert_state", "path": "eliteJack.type", "equals": "ZOMBIE_ELITE_JACK_IN_THE_BOX" },
