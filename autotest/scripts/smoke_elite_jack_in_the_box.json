    { "op": "assert_state", "path": "eliteJack.eliteJackBoxInFlight", "equals": true },
    { "op": "assert_state", "path": "eliteJack.eliteJackBoxTrackVisible", "equals": false },
    { "op": "assert_state", "path": "eliteJack.eliteJackTargetRow", "equals": 1 },
    { "op": "assert_state", "path": "plants.0.health", "equals": 300 },
