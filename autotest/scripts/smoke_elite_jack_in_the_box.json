    { "op": "set_elite_jack_throw_countdown", "row": 2, "value": 0.05 },
    { "op": "wait_seconds", "value": 0.2, "timeout": 3 },
    { "op": "assert_state", "path": "eliteJack.eliteJackBoxInFlight", "equals": false },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 2, "x": 602, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 2, "x": 682, "stationary": true },
    { "op": "charm_zombie", "row": 2, "index": 2 },
    { "op": "set_elite_jack_throw_countdown", "row": 2, "value": 0.05 },
    { "op": "wait_seconds", "value": 0.2, "timeout": 3 },
    { "op": "assert_state", "path": "eliteJack.eliteJackBoxInFlight", "equals": true },
    { "op": "assert_state", "path": "eliteJack.eliteJackThrowWasMindControlled", "equals": true },
    { "op": "wait_seconds", "value": 0.65, "timeout": 3 },
    { "op": "assert_state", "path": "eliteJack.bodyHealth", "equals": 900 },
    { "op": "assert_state", "path": "zombies.1.bodyHealth", "equals": 220 },
    { "op": "assert_state", "path": "zombies.1.mindControlled", "equals": false },
    { "op": "assert_state", "path": "zombies.2.bodyHealth", "equals": 270 },
    { "op": "assert_state", "path": "zombies.2.mindControlled", "equals": true },
    { "op": "assert_state", "path": "plants.0.health", "equals": 4000 },
    { "op": "assert_state", "path": "jackExplosionSoundRequestCount", "equals": 2 },
    { "op": "assert_state", "path": "particleEffectNameCounts.JackExplode", "equals": 1 },
    { "op": "screenshot", "name": "04_charmed_box_damages_enemy_zombie.png" },

    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 310, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "eliteJack.bodyHealth", "equals": 590 },
    { "op": "assert_state", "path": "eliteJack.hasArm", "equals": false },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieEliteJackboxArmOff", "equals": 1 },
    { "op": "screenshot", "name": "05_elite_jack_arm_drop.png" },
    { "op": "assert_state", "path": "particleEffectsByName.ZombieEliteJackboxArmOff.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "particleEffectsByName.ZombieEliteJackboxArmOff.0.renderQuadCount", "equals": 1 },
    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 590, "source": "OTHER" },
    { "op": "wait_seconds", "value": 0.15, "timeout": 2 },
    { "op": "assert_state", "path": "eliteJack.hasHead", "equals": false },
    { "op": "assert_state", "path": "eliteJack.isDying", "equals": true },
    { "op": "assert_state", "path": "eliteJack.track", "equals": "anim_death" },
    { "op": "assert_state", "path": "jackLoopSoundPlaying", "equals": false },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieHeadOff", "equals": 1 },
    { "op": "screenshot", "name": "06_elite_jack_death_track.png" },
    { "op": "wait_seconds", "value": 1.3, "timeout": 3 },
    { "op": "assert_state", "path": "eliteJackZombieCount", "equals": 0 },

    { "op": "dump_state", "name": "elite_jack_in_the_box_final_state.json" },
    { "op": "set_spawn_paused", "value": false },
    { "op": "quit" }
  ]
}
