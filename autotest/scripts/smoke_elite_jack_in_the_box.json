    { "op": "assert_state", "path": "eliteJackZombieCount", "equals": 1 },
    { "op": "assert_state", "path": "eliteJack.bodyHealth", "equals": 900 },
    { "op": "assert_state", "path": "eliteJack.eliteJackBoxInFlight", "equals": false },
    { "op": "assert_state", "path": "eliteJack.eliteJackBoxTrackVisible", "equals": true },
    { "op": "assert_state", "path": "plants.0.health", "equals": 250 },
    { "op": "assert_state", "path": "plants.1.health", "equals": 300 },
    { "op": "assert_state", "path": "jackExplosionSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.JackExplode", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.JackExplode.0.renderProbeReady", "equals": true },
    { "op": "screenshot", "name": "03_box_impact_restores_hand_box.png" },
    { "op": "wait_seconds", "value": 0.2, "timeout": 2 },
    { "op": "assert_state", "path": "plants.0.health", "equals": 250 },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_WALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
