{
  "commands": [
    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_SUNFLOWER", "PLANT_PEASHOOTER", "PLANT_WALLNUT"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },

    { "op": "plant", "type": "PLANT_SUNFLOWER", "row": 1, "col": 2 },
    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 3, "col": 7 },
    { "op": "spawn_zombie", "type": "ZOMBIE_NORMAL", "row": 4, "x": 850 },
    { "op": "spawn_zombie", "type": "ZOMBIE_TRAFFIC_CONE", "row": 4, "x": 980 },
    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_JACK_IN_THE_BOX", "row": 2, "x": 950, "stationary": true },
    { "op": "set_elite_jack_throw_countdown", "row": 2, "value": 0.05 },
    { "op": "wait_seconds", "value": 0.15, "timeout": 3 },

    { "op": "assert_state", "path": "monteCarloAIEnabled", "equals": true },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_SUNFLOWER.simulationSunPerSecondOn100", "equals": 125 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_SUNFLOWER.simulationFirstSunDelayMs", "equals": 5550 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_PEASHOOTER.simulationAttackDpsOn100", "equals": 1333 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_CHERRYBOMB.simulationPersistent", "equals": false },
    { "op": "assert_state", "path": "eliteJack.eliteJackBoxInFlight", "equals": true },
    { "op": "assert_state", "path": "eliteJack.eliteJackTargetingMode", "equals": "MONTE_CARLO" },
    { "op": "assert_state", "path": "eliteJack.eliteJackMonteCarloRolloutCount", "equals": 64 },
    { "op": "assert_state", "path": "eliteJack.eliteJackMonteCarloCandidateCount", "equals": 2 },
    { "op": "assert_state", "path": "eliteJack.eliteJackMonteCarloZombieCount", "equals": 3 },
    { "op": "assert_state", "path": "eliteJack.eliteJackMonteCarloCardCount", "equals": 3 },
    { "op": "assert_state", "path": "eliteJack.eliteJackTargetRow", "equals": 1 },
    { "op": "assert_state", "path": "eliteJack.eliteJackTargetXInt", "equals": 442 },
    { "op": "screenshot", "name": "elite_jack_monte_carlo_targets_economy.png" },

    { "op": "wait_seconds", "value": 0.75, "timeout": 3 },
    { "op": "assert_state", "path": "plants.0.type", "equals": "PLANT_SUNFLOWER" },
    { "op": "assert_state", "path": "plants.0.health", "equals": 250 },
    { "op": "assert_state", "path": "plants.1.type", "equals": "PLANT_PEASHOOTER" },
    { "op": "assert_state", "path": "plants.1.health", "equals": 300 },
    { "op": "dump_state", "name": "elite_jack_monte_carlo_targeting.json" },
    { "op": "set_spawn_paused", "value": false },
    { "op": "quit" }
  ]
}
