    { "op": "set_ice_wall_engineer_state", "row": 3, "phase": "BUILDING", "remaining": 0.3, "wallX": 700, "used": false },
    { "op": "save_level_snapshot", "name": "ice_wall_engineer_building" },
    { "op": "reload_level_snapshot", "name": "ice_wall_engineer_building" },
    { "op": "assert_state", "path": "weather.iceWallEngineersSpawnedThisWave", "equals": 1 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_WALL_ENGINEER.constructionPhase", "equals": "BUILDING" },
    { "op": "assert_state", "path": "iceWall.constructionComplete", "equals": false },
    { "op": "assert_state", "path": "iceWall.health", "equals": 600 },
    { "op": "wait_seconds", "value": 0.45 },
