    { "op": "assert_state", "path": "iceWall.builderZombieID", "equals": -1024 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ICE_WALL_ENGINEER.constructionPhase", "equals": "COMPLETED" },
    { "op": "assert_state", "path": "particleEffectNameCounts.IceWallBuild", "atLeast": 1 },
    { "op": "screenshot", "name": "02_ice_wall_engineer_completed.png" },

    { "op": "kill_zombie", "row": 3, "index": 0 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "iceWall.health", "equals": 1800 },
    { "op": "save_level_snapshot", "name": "ice_wall_without_engineer" },
