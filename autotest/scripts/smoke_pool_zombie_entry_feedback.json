{
  "commands": [
    { "op": "goto_level", "level": 19 },
    { "op": "choose_cards", "cards": ["PLANT_LILYPAD"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "assert_state", "path": "poolSplashResources.reanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "poolSplashResources.soundsLoaded", "equals": true },
    { "op": "assert_state", "path": "poolSplashResources.waterParticlePartsLoaded", "equals": true },
    { "op": "assert_state", "path": "particleEffectNameCounts.PlantingPool", "equals": 0 },
    { "op": "assert_state", "path": "animatedObjectTagCounts.PoolSplash", "equals": 0 },
    { "op": "assert_state", "path": "poolTransitionSoundRequestCount", "equals": 0 },

    { "op": "spawn_zombie", "type": "ZOMBIE_POOL_NORMAL", "row": 2, "x": 930, "stationary": true },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.0.inPool", "equals": true },
    { "op": "assert_state", "path": "particleEffectNameCounts.PlantingPool", "equals": 0 },
    { "op": "assert_state", "path": "animatedObjectTagCounts.PoolSplash", "equals": 0 },
    { "op": "assert_state", "path": "poolTransitionSoundRequestCount", "equals": 0 },

    { "op": "spawn_zombie", "type": "ZOMBIE_POOL_NORMAL", "row": 3, "x": 958 },
    { "op": "assert_state", "path": "zombies.1.inPool", "equals": false },
    { "op": "wait_seconds", "value": 0.25, "timeout": 3 },
    { "op": "assert_state", "path": "zombies.1.inPool", "equals": true },
    { "op": "assert_state", "path": "particleEffectNameCounts.PlantingPool", "equals": 1 },
    { "op": "assert_state", "path": "animatedObjectTagCounts.PoolSplash", "equals": 1 },
    { "op": "assert_state", "path": "poolTransitionSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectsByName.PlantingPool.0.activeParticleCount", "atLeast": 12 },
    { "op": "assert_state", "path": "particleEffectsByName.PlantingPool.0.nearestZombie.row", "equals": 3 },
    { "op": "screenshot", "name": "pool_zombie_entry_splash.png" },
    { "op": "dump_state", "name": "pool_zombie_entry_splash_state.json" },

    { "op": "wait_seconds", "value": 0.8, "timeout": 3 },
    { "op": "assert_state", "path": "particleEffectNameCounts.PlantingPool", "equals": 0 },
    { "op": "assert_state", "path": "animatedObjectTagCounts.PoolSplash", "equals": 0 },
    { "op": "save_level_snapshot", "name": "pool_entry_complete" },
    { "op": "reload_level_snapshot", "name": "pool_entry_complete" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombies.1.inPool", "equals": true },
    { "op": "assert_state", "path": "particleEffectNameCounts.PlantingPool", "equals": 0 },
    { "op": "assert_state", "path": "animatedObjectTagCounts.PoolSplash", "equals": 0 },
    { "op": "assert_state", "path": "poolTransitionSoundRequestCount", "equals": 1 },
    { "op": "quit" }
  ]
}
