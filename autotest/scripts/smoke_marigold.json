{
  "commands": [
    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_MARIGOLD"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 0 },

    { "op": "assert_state", "path": "marigoldResources.reanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "marigoldResources.cardLoaded", "equals": true },
    { "op": "assert_state", "path": "marigoldResources.partsLoaded", "equals": true },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_MARIGOLD.sunCost", "equals": -100 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_MARIGOLD.cooldownMs", "equals": 25000 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_MARIGOLD.simulationBaseHealth", "equals": 300 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_MARIGOLD.simulationSunPerSecondOn100", "equals": 0 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_MARIGOLD.simulationPersistent", "equals": true },
    { "op": "assert_state", "path": "cards.0.type", "equals": "PLANT_MARIGOLD" },
    { "op": "assert_state", "path": "cards.0.ready", "equals": true },

    { "op": "click", "x": 220, "y": 25 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "cards.0.selected", "equals": true },
    { "op": "move_mouse", "x": 442, "y": 128 },
    { "op": "wait_frames", "value": 2 },
    { "op": "click", "x": 442, "y": 128 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "sun", "equals": 100 },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.type", "equals": "PLANT_MARIGOLD" },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.health", "equals": 300 },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.track", "equals": "anim_idle" },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.hasShadow", "equals": true },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.shadowOffsetXInt", "equals": 0 },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.shadowOffsetYInt", "equals": 28 },
    { "op": "assert_state", "path": "cards.0.cooldown", "equals": true },
    { "op": "screenshot", "name": "01_marigold_single.png" },
    { "op": "assert_state", "path": "animatedObjectsByTag.Plant.0.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "animatedObjectsByTag.Plant.0.nearestPlant.row", "equals": 0 },
    { "op": "assert_state", "path": "animatedObjectsByTag.Plant.0.nearestPlant.col", "equals": 2 },
    { "op": "dump_state", "name": "marigold_single_state.json" },
    { "op": "save_level_snapshot", "name": "marigold_idle" },
    { "op": "reload_level_snapshot", "name": "marigold_idle" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.type", "equals": "PLANT_MARIGOLD" },
    { "op": "assert_state", "path": "topPlantsByCell.0_2.track", "equals": "anim_idle" },

    { "op": "set_timescale", "value": 10.0 },
    { "op": "wait_seconds", "value": 25.1, "timeout": 5 },
    { "op": "set_timescale", "value": 1.0 },
    { "op": "assert_state", "path": "cards.0.cooldown", "equals": false },
    { "op": "assert_state", "path": "sun", "equals": 100 },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_SUNFLOWER", "PLANT_MARIGOLD", "PLANT_PUFFSHROOM"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_SUNFLOWER", "row": 2, "col": 2 },
    { "op": "plant", "type": "PLANT_MARIGOLD", "row": 2, "col": 3 },
    { "op": "plant", "type": "PLANT_PUFFSHROOM", "row": 2, "col": 4 },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.type", "equals": "PLANT_MARIGOLD" },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.track", "equals": "anim_idle" },
    { "op": "screenshot", "name": "02_marigold_alignment.png" },
    { "op": "dump_state", "name": "marigold_final_state.json" },
    { "op": "quit" }
  ]
}
