{
  "commands": [
    { "op": "goto_level", "level": 10, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "assert_state", "path": "openingTyphoonProtectionEnabled", "equals": true },
    { "op": "assert_state", "path": "wave", "equals": 0 },
    { "op": "assert_state", "path": "weather.openingTyphoonProtectionActive", "equals": true },
    { "op": "assert_state", "path": "weather.typhoonSupported", "equals": true },
    { "op": "assert_state", "path": "weather.typhoonChancePct", "equals": 0 },

    { "op": "set_weather", "intensity": "HEAVY", "duration": 60 },
    { "op": "roll_typhoon", "chanceRoll": 1, "strengthRoll": 1, "direction": "HOUSE" },
    { "op": "assert_state", "path": "weather.typhoonStrength", "equals": "NONE" },
    { "op": "assert_state", "path": "weather.heavyPhasesWithoutTyphoon", "equals": 0 },

    { "op": "set_weather", "intensity": "CLEAR", "duration": 60 },
    { "op": "set_weather_forecast", "forecast": "HEAVY", "actual": "HEAVY", "revealIn": 1.0 },
    { "op": "assert_state", "path": "weather.pendingTyphoonPrepared", "equals": true },
    { "op": "assert_state", "path": "weather.pendingTyphoonOpeningProtected", "equals": true },
    { "op": "assert_state", "path": "weather.pendingTyphoonStrength", "equals": "NONE" },
    { "op": "set_timescale", "value": 0.0 },
    { "op": "save_level_snapshot", "name": "opening_typhoon_protected_forecast" },
    { "op": "reload_level_snapshot", "name": "opening_typhoon_protected_forecast" },
    { "op": "assert_state", "path": "weather.pendingTyphoonOpeningProtected", "equals": true },
    { "op": "set_timescale", "value": 1.0 },
    { "op": "wait_seconds", "value": 1.2, "timeout": 3 },
    { "op": "assert_state", "path": "weather.intensity", "equals": "HEAVY" },
    { "op": "assert_state", "path": "weather.typhoonStrength", "equals": "NONE" },
    { "op": "assert_state", "path": "weather.heavyPhasesWithoutTyphoon", "equals": 0 },

    { "op": "set_opening_typhoon_protection", "value": false },
    { "op": "assert_state", "path": "openingTyphoonProtectionEnabled", "equals": false },
    { "op": "assert_state", "path": "weather.openingTyphoonProtectionActive", "equals": false },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 60 },
    { "op": "roll_typhoon", "chanceRoll": 1, "strengthRoll": 1, "direction": "HOUSE" },
    { "op": "assert_state", "path": "weather.typhoonStrength", "equals": "TYPHOON" },

    { "op": "goto_level", "level": 10, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "summon_next_wave", "count": 5 },
    { "op": "assert_state", "path": "wave", "equals": 5 },
    { "op": "assert_state", "path": "weather.openingTyphoonProtectionActive", "equals": true },
    { "op": "assert_state", "path": "weather.typhoonChancePct", "equals": 0 },
    { "op": "summon_next_wave" },
    { "op": "assert_state", "path": "wave", "equals": 6 },
    { "op": "assert_state", "path": "weather.openingTyphoonProtectionActive", "equals": false },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 60 },
    { "op": "roll_typhoon", "chanceRoll": 1, "strengthRoll": 1, "direction": "FRONT" },
    { "op": "assert_state", "path": "weather.typhoonStrength", "equals": "TYPHOON" },

    { "op": "goto_level", "level": 1001, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "assert_state", "path": "survivalRound", "equals": 1 },
    { "op": "assert_state", "path": "weather.openingTyphoonProtectionActive", "equals": true },
    { "op": "assert_state", "path": "weather.typhoonSupported", "equals": true },
    { "op": "force_survival_round", "round": 2 },
    { "op": "assert_state", "path": "weather.openingTyphoonProtectionActive", "equals": false },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 60 },
    { "op": "set_typhoon", "strength": "TYPHOON", "direction": "HOUSE" },
    { "op": "assert_state", "path": "weather.typhoonStrength", "equals": "TYPHOON" },
    { "op": "dump_state", "name": "opening_typhoon_protection_final_state" },
    { "op": "quit" }
  ]
}
