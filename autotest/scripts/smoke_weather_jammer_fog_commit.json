    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerPhase", "equals": "SPENT" },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_WEATHER_JAMMER.jammerCommittedDisruptionMask", "equals": 5 },
    { "op": "assert_state", "path": "weather.forecastDisrupted", "equals": true },
    { "op": "assert_state", "path": "weather.pendingTyphoonStrength", "equals": "SUPER" },
    { "op": "assert_state", "path": "fog.forecastDisrupted", "equals": true },
    { "op": "assert_state", "path": "fog.lockedActualIntensity", "equals": "SMALL" },
