{
  "commands": [
    { "op": "goto_level", "level": 1 },
    { "op": "choose_cards", "cards": ["PLANT_CACTUS"] },
    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 2000 },
    { "op": "plant", "type": "PLANT_CACTUS", "row": 2, "col": 2 },
    { "op": "spawn_zombie", "type": "ZOMBIE_BALLOON", "row": 2, "x": 1000 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.balloonPhase", "equals": "FLYING" },
    { "op": "assert_state", "path": "zombies.0.balloonHealth", "equals": 20 },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 270 },
    { "op": "assert_state", "path": "zombies.0.flying", "equals": true },
    { "op": "assert_state", "path": "zombies.0.balloonPropellerPlaying", "equals": true },
    { "op": "assert_state", "path": "balloonInflateSoundRequestCount", "equals": 1 },
    { "op": "wait_seconds", "value": 0.75, "timeout": 3 },
    { "op": "assert_state", "path": "plants.0.cactusPhase", "equals": "RISING" },
    { "op": "assert_state", "path": "plants.0.cactusHasFlyingTarget", "equals": true },
    { "op": "assert_state", "path": "plantGrowSoundRequestCount", "equals": 1 },
    { "op": "screenshot", "name": "01_cactus_rising_for_balloon.png" },
    { "op": "wait_seconds", "value": 1.45, "timeout": 4 },
    { "op": "assert_state", "path": "plants.0.cactusPhase", "equals": "HIGH" },
    { "op": "wait_seconds", "value": 0.3, "timeout": 3 },
    { "op": "assert_state", "path": "flyingTargetSpikeCount", "atLeast": 1 },
    { "op": "screenshot", "name": "02_cactus_high_spike.png" },
    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 20, "source": "OTHER" },
    { "op": "assert_state", "path": "zombies.0.balloonPhase", "equals": "POPPING" },
    { "op": "assert_state", "path": "zombies.0.balloonHealth", "equals": 0 },
    { "op": "assert_state", "path": "zombies.0.bodyHealth", "equals": 270 },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_pop" },
    { "op": "assert_state", "path": "balloonPopSoundRequestCount", "equals": 1 },
    { "op": "save_level_snapshot", "name": "balloon_popping" },
    { "op": "reload_level_snapshot", "name": "balloon_popping" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.balloonPhase", "equals": "POPPING" },
    { "op": "assert_state", "path": "zombies.0.balloonPropellerPlaying", "equals": true },
    { "op": "screenshot", "name": "03_balloon_pop_after_reload.png" },
    { "op": "wait_seconds", "value": 1.35, "timeout": 4 },
    { "op": "assert_state", "path": "zombies.0.balloonPhase", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.flying", "equals": false },
    { "op": "wait_seconds", "value": 1.8, "timeout": 4 },
    { "op": "assert_state", "path": "plants.0.cactusHasFlyingTarget", "equals": false },
    { "op": "assert_state", "path": "plants.0.cactusHasGroundTarget", "equals": true },
    { "op": "assert_state", "path": "plants.0.cactusPhase", "equals": "LOW" },
    { "op": "screenshot", "name": "04_balloon_landed_cactus_low.png" },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME" },
    { "op": "set_spawn_paused", "value": true },
    { "op": "plant", "type": "PLANT_PEASHOOTER", "row": 2, "col": 1 },
    { "op": "plant", "type": "PLANT_CACTUS", "row": 2, "col": 2 },
    { "op": "spawn_zombie", "type": "ZOMBIE_BALLOON", "row": 2, "x": 700, "stationary": true },
    { "op": "assert_can_target", "plantType": "PLANT_PEASHOOTER", "plantRow": 2, "plantCol": 1, "zombieRow": 2, "expected": false },
    { "op": "assert_can_target", "plantType": "PLANT_CACTUS", "plantRow": 2, "plantCol": 2, "zombieRow": 2, "expected": true },
    { "op": "spawn_bullet", "type": "BULLET_SPIKE", "row": 2, "x": 700, "y": 230, "velocityX": 0, "targetsFlying": false },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.balloonHealth", "equals": 20 },
    { "op": "assert_state", "path": "groundTargetSpikePiercedZombieCount", "equals": 0 },
    { "op": "spawn_bullet", "type": "BULLET_SPIKE", "row": 2, "x": 700, "y": 230, "velocityX": 0, "targetsFlying": true },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "zombies.0.balloonHealth", "atMost": 19 },
    { "op": "assert_state", "path": "flyingTargetSpikePiercedZombieCount", "equals": 1 },
    { "op": "save_level_snapshot", "name": "balloon_target_layers" },
    { "op": "reload_level_snapshot", "name": "balloon_target_layers" },
    { "op": "assert_state", "path": "groundTargetSpikeCount", "equals": 1 },
    { "op": "assert_state", "path": "flyingTargetSpikeCount", "equals": 1 },
    { "op": "assert_state", "path": "groundTargetSpikePiercedZombieCount", "equals": 0 },
    { "op": "assert_state", "path": "flyingTargetSpikePiercedZombieCount", "equals": 1 },

    { "op": "goto_level", "level": 19, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME" },
    { "op": "set_spawn_paused", "value": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_BALLOON", "row": 2, "x": 700 },
    { "op": "damage_zombie", "row": 2, "index": 0, "damage": 20, "source": "OTHER" },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },
    { "op": "assert_state", "path": "balloonPopSoundRequestCount", "equals": 2 },
    { "op": "screenshot", "name": "05_pool_balloon_removed.png" },

    { "op": "goto_level", "level": 1, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_WALLNUT"] },
    { "op": "wait_state", "state": "GAME" },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 2000 },
    { "op": "plant", "type": "PLANT_WALLNUT", "row": 0, "col": 5 },
    { "op": "spawn_zombie", "type": "ZOMBIE_BALLOON", "row": 0, "x": 700 },
    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 20, "source": "OTHER" },
    { "op": "wait_seconds", "value": 1.5, "timeout": 4 },
    { "op": "assert_state", "path": "zombies.0.balloonPhase", "equals": "WALKING" },
    { "op": "assert_state", "path": "zombies.0.isEating", "equals": true },
    { "op": "wait_seconds", "value": 0.7, "timeout": 3 },
    { "op": "assert_state", "path": "plants.0.health", "atMost": 3950 },
    { "op": "screenshot", "name": "06_balloon_eating_after_landing.png" },
    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 90, "source": "OTHER" },
    { "op": "assert_state", "path": "zombies.0.hasArm", "equals": false },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieBalloonArmOff", "equals": 1 },
    { "op": "screenshot", "name": "07_balloon_arm_drop.png" },
    { "op": "damage_zombie", "row": 0, "index": 0, "damage": 90, "source": "OTHER" },
    { "op": "assert_state", "path": "zombies.0.hasHead", "equals": false },
    { "op": "assert_state", "path": "zombies.0.balloonHatVisible", "equals": false },
    { "op": "assert_state", "path": "zombies.0.balloonPropellerPlaying", "equals": false },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZombieBalloonHeadOff", "equals": 1 },
    { "op": "screenshot", "name": "08_balloon_head_drop.png" },
    { "op": "wait_seconds", "value": 2.3, "timeout": 4 },
    { "op": "assert_state", "path": "zombies.0.track", "equals": "anim_death" },
    { "op": "assert_state", "path": "zombies.0.isDying", "equals": true },
    { "op": "screenshot", "name": "09_balloon_death.png" },
    { "op": "wait_seconds", "value": 1.3, "timeout": 4 },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },
    { "op": "dump_state", "name": "balloon_cactus_final.json" },
    { "op": "quit" }
  ]
}
