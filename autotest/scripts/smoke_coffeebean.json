    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleepIndicatorOffsetXOn1000", "equals": 10000 },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleepIndicatorOffsetYOn1000", "equals": 0 },
