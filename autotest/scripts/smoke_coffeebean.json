    { "op": "assert_state", "path": "overlayPlantsByCell.2_3.coffeeBeanPhase", "equals": "CRUMBLING" },
    { "op": "assert_state", "path": "overlayPlantsByCell.2_3.track", "equals": "anim_crumble" },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleeping", "equals": true },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleepIndicatorVisible", "equals": true },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.wakeUpTimeMs", "atLeast": 800, "atMost": 1000 },
    { "op": "assert_state", "path": "coffeeSoundRequestCount", "equals": 1 },
    { "op": "save_level_snapshot", "name": "coffee_crumbling" },
    { "op": "wait_seconds", "value": 0.10 },
    { "op": "reload_level_snapshot", "name": "coffee_crumbling" },
    { "op": "assert_state", "path": "overlayPlantsByCell.2_3.coffeeBeanPhase", "equals": "CRUMBLING" },
    { "op": "assert_state", "path": "coffeeSoundRequestCount", "equals": 1 },

    { "op": "wait_seconds", "value": 0.50 },
