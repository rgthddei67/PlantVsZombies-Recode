    { "op": "plant", "type": "PLANT_INSTANT_COFFEE", "row": 2, "col": 3 },
    { "op": "assert_can_plant", "type": "PLANT_INSTANT_COFFEE", "row": 2, "col": 3, "expected": false },
    { "op": "screenshot", "name": "01_waiting_over_sleeping_puff.png" },
    { "op": "dump_state", "name": "01_waiting.json" },
    { "op": "assert_state", "path": "cells.2.3.normal", "equals": "PLANT_PUFFSHROOM" },
    { "op": "assert_state", "path": "cells.2.3.overlay", "equals": "PLANT_INSTANT_COFFEE" },
    { "op": "assert_state", "path": "overlayPlantsByCell.2_3.coffeeBeanPhase", "equals": "WAITING" },
    { "op": "assert_state", "path": "overlayPlantsByCell.2_3.hasShadow", "equals": false },
    { "op": "assert_state", "path": "overlayPlantsByCell.2_3.canBeEaten", "equals": false },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.wakeUpTimeMs", "equals": 0 },
    { "op": "assert_state", "path": "coffeeSoundRequestCount", "equals": 0 },

    { "op": "wait_seconds", "value": 0.35 },
    { "op": "save_level_snapshot", "name": "coffee_waiting" },
    { "op": "wait_seconds", "value": 0.20 },
    { "op": "reload_level_snapshot", "name": "coffee_waiting" },
    { "op": "assert_state", "path": "overlayPlantsByCell.2_3.coffeeBeanPhase", "equals": "WAITING" },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleepIndicatorVisible", "equals": true },
    { "op": "assert_state", "path": "coffeeSoundRequestCount", "equals": 0 },

    { "op": "wait_seconds", "value": 0.75 },
