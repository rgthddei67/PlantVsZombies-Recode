    { "op": "assert_state", "path": "plantWakeupSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleeping", "equals": true },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.renderScaleYPct", "atLeast": 80, "atMost": 120 },

    { "op": "wait_seconds", "value": 0.60 },
    { "op": "screenshot", "name": "04_puff_awake.png" },
    { "op": "dump_state", "name": "04_awake.json" },
    { "op": "assert_state", "path": "cells.2.3.overlay", "equals": "NONE" },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleeping", "equals": false },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleepIndicatorVisible", "equals": false },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.wakeUpTimeMs", "equals": 0 },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.track", "equals": "anim_idle" },
    { "op": "assert_can_plant", "type": "PLANT_INSTANT_COFFEE", "row": 2, "col": 3, "expected": false },
    { "op": "save_level_snapshot", "name": "coffee_awake" },
    { "op": "reload_level_snapshot", "name": "coffee_awake" },
    { "op": "assert_state", "path": "plantWakeupSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "coffeeSoundRequestCount", "equals": 1 },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleeping", "equals": false },
    { "op": "assert_state", "path": "topPlantsByCell.2_3.sleepIndicatorVisible", "equals": false },

    { "op": "goto_level", "level": 19, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_LILYPAD", "PLANT_DOOMSHROOM", "PLANT_INSTANT_COFFEE"] },
    { "op": "wait_state", "state": "GAME" },
    { "op": "set_sun", "value": 1000 },
    { "op": "plant", "type": "PLANT_LILYPAD", "row": 2, "col": 4 },
    { "op": "plant", "type": "PLANT_DOOMSHROOM", "row": 2, "col": 4 },
    { "op": "assert_can_plant", "type": "PLANT_INSTANT_COFFEE", "row": 2, "col": 4, "expected": true },
    { "op": "plant", "type": "PLANT_INSTANT_COFFEE", "row": 2, "col": 4 },
    { "op": "wait_seconds", "value": 2.10 },
    { "op": "screenshot", "name": "05_day_pool_doom_awake.png" },
    { "op": "assert_state", "path": "topPlantsByCell.2_4.type", "equals": "PLANT_DOOMSHROOM" },
    { "op": "assert_state", "path": "topPlantsByCell.2_4.sleeping", "equals": false },
    { "op": "assert_state", "path": "topPlantsByCell.2_4.track", "equals": "anim_explode" },
    { "op": "wait_seconds", "value": 1.60 },
    { "op": "screenshot", "name": "06_day_pool_doom_crater.png" },
    { "op": "dump_state", "name": "06_day_pool_doom_crater.json" },
    { "op": "assert_state", "path": "craters.0.row", "equals": 2 },
    { "op": "assert_state", "path": "craters.0.col", "equals": 4 },
    { "op": "assert_state", "path": "cells.2.4.under", "equals": "NONE" },
    { "op": "assert_state", "path": "cells.2.4.normal", "equals": "NONE" },
    { "op": "assert_state", "path": "cells.2.4.overlay", "equals": "NONE" },

    { "op": "goto_level", "level": 19, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PUFFSHROOM", "PLANT_INSTANT_COFFEE"] },
    { "op": "wait_state", "state": "GAME" },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 1000 },
    { "op": "plant", "type": "PLANT_PUFFSHROOM", "row": 0, "col": 3 },
    { "op": "plant", "type": "PLANT_INSTANT_COFFEE", "row": 0, "col": 3 },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "set_typhoon", "strength": "SEVERE", "direction": "FRONT", "gustIn": 30, "directionIn": 30, "gustsRemaining": 1, "decayIn": 60 },
    { "op": "trigger_typhoon_gust", "plantMoveIn": 0 },
    { "op": "wait_frames", "value": 2 },
    { "op": "assert_state", "path": "cells.0.3.normal", "equals": "NONE" },
    { "op": "assert_state", "path": "cells.0.3.overlay", "equals": "NONE" },
    { "op": "assert_state", "path": "cells.0.4.normal", "equals": "PLANT_PUFFSHROOM" },
    { "op": "assert_state", "path": "cells.0.4.overlay", "equals": "PLANT_INSTANT_COFFEE" },
    { "op": "assert_state", "path": "topPlantsByCell.0_4.sleeping", "equals": true },
    { "op": "assert_state", "path": "topPlantsByCell.0_4.sleepIndicatorVisible", "equals": true },
    { "op": "assert_state", "path": "overlayPlantsByCell.0_4.coffeeBeanPhase", "equals": "WAITING" },
    { "op": "screenshot", "name": "07_typhoon_moves_sleeping_stack.png" },

    { "op": "quit" }
  ]
