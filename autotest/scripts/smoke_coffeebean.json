    { "op": "set_sun", "value": 1000 },

    { "op": "assert_state", "path": "coffeeBeanResources.reanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "coffeeBeanResources.cardLoaded", "equals": true },
    { "op": "assert_state", "path": "coffeeBeanResources.soundLoaded", "equals": true },
    { "op": "assert_state", "path": "sleepIndicatorResources.reanimationLoaded", "equals": true },
    { "op": "assert_state", "path": "sleepIndicatorResources.textureLoaded", "equals": true },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_INSTANT_COFFEE.sunCost", "equals": 75 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_INSTANT_COFFEE.cooldownMs", "equals": 7500 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_INSTANT_COFFEE.simulationBaseHealth", "equals": 300 },
    { "op": "assert_state", "path": "plantDefinitions.PLANT_INSTANT_COFFEE.simulationPersistent", "equals": false },
