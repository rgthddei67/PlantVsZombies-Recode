{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "D:/PVZ/vcpkg-master/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VULKAN_SDK": "D:/VulkanSDK",
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-ports"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/Llvm/x64/bin/clang-cl.exe",
        "CMAKE_LINKER_TYPE": "LLD"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
            "intelliSenseMode": "windows-clangcl-x64"
        }
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release（默认：/O2 + AVX2 + fast-math + LTO + 精简行表 PDB）",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PVZ_ENABLE_LTO": "ON",
        "PVZ_ENABLE_AVX2": "ON",
        "PVZ_ENABLE_PDB": "ON"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug（仅显式诊断：/Od + /MTd + Debug CRT/PDB）",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PVZ_ENABLE_LTO": "OFF",
        "PVZ_ENABLE_AVX2": "OFF",
        "PVZ_ENABLE_PDB": "OFF",
        "PVZ_SHARED_RUNTIME_ROOT": "${sourceDir}/build/clang-release"
      }
    },
    {
      "name": "clang-release-noavx2",
      "displayName": "Clang Release No AVX2（Win7 兼容：/O2 + fast-math + LTO + 精简行表 PDB）",
      "inherits": "clang-release",
      "cacheVariables": {
        "PVZ_ENABLE_AVX2": "OFF",
        "PVZ_SHARED_RUNTIME_ROOT": "${sourceDir}/build/clang-release"
      }
    }
  ],
  "buildPresets": [
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release-noavx2", "configurePreset": "clang-release-noavx2" }
  ]
}
