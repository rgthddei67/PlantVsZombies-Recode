[Unit]
Description=Write a daily PvZ backup node health report
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pvz-server-health-report
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/srv/codex/health
